---
import '../styles/global.css';

import Entete from '../components/Entete.astro';
import EnteteNue from '../components/EnteteNue.astro';
import Pied from '../components/Pied.astro';
import Icone from '../components/Icone.astro';
import { site } from '../data/site.js';

interface Props {
  titre: string;
  description: string;
  image?: string;
  noindex?: boolean;
  barreMobile?: boolean;
  filAriane?: { nom: string; lien: string }[];
  /** Page de conversion : en-tête réduit au logo, sans menu. */
  pageConversion?: boolean;
  typeOg?: string;
}

const {
  titre,
  description,
  image = '/og-elyostudio.png',
  noindex = false,
  barreMobile = true,
  filAriane = [],
  pageConversion = false,
  typeOg = 'website',
} = Astro.props;

const canonique = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site ?? site.url).href;
const imageAbsolue = new URL(image, Astro.site ?? site.url).href;

// Données structurées communes à toutes les pages.
const donneesCommunes = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['ProfessionalService', 'Organization'],
      '@id': `${site.url}/#studio`,
      name: site.nom,
      alternateName: 'Elyo Studio',
      description: site.promesse,
      url: site.url,
      logo: `${site.url}/logo-elyostudio.svg`,
      image: `${site.url}/og-elyostudio.png`,
      email: site.email,
      telephone: site.telephoneLien,
      priceRange: '€€',
      currenciesAccepted: 'EUR',
      areaServed: [
        { '@type': 'Country', name: 'France' },
        ...(site.zonesDesservies ?? []).map((v) => ({ '@type': 'City', name: v })),
      ],
      address: {
        '@type': 'PostalAddress',
        streetAddress: '49 avenue du Bois',
        postalCode: '65800',
        addressLocality: site.ville,
        addressRegion: site.region,
        addressCountry: 'FR',
      },
      // Renseignés depuis le CMS (Réglages) ; omis tant qu'ils sont vides,
      // pour ne jamais publier de coordonnées ou d'horaires inventés.
      ...(site.geo?.latitude && site.geo?.longitude
        ? {
            geo: {
              '@type': 'GeoCoordinates',
              latitude: site.geo.latitude,
              longitude: site.geo.longitude,
            },
          }
        : {}),
      ...(site.horaires?.ouverture && site.horaires?.fermeture
        ? {
            openingHoursSpecification: {
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
              opens: site.horaires.ouverture,
              closes: site.horaires.fermeture,
            },
          }
        : {}),
      founder: { '@id': `${site.url}/#julien` },
      knowsAbout: [
        'Positionnement et structuration d’offre',
        'Création de site internet',
        'Référencement local',
        'Fiche Google Business Profile',
        'Accompagnement de thérapeutes indépendants',
        'Prise de rendez-vous en ligne',
      ],
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#julien`,
      name: 'Julien Duplouy',
      jobTitle: 'Fondateur d’ElyoStudio — développement de cabinet pour les professionnels de l’accompagnement',
      worksFor: { '@id': `${site.url}/#studio` },
      url: `${site.url}/a-propos`,
      image: `${site.url}/images/julien-duplouy-440.webp`,
      email: site.email,
      knowsAbout: ['Référencement local', 'Rédaction web', 'Sites pour praticiens du bien-être'],
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.ville,
        addressRegion: site.region,
        addressCountry: 'FR',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#site`,
      url: site.url,
      name: site.nom,
      inLanguage: 'fr-FR',
      publisher: { '@id': `${site.url}/#studio` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonique}#page`,
      url: canonique,
      name: titre,
      description,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': `${site.url}/#site` },
      about: { '@id': `${site.url}/#studio` },
    },
    ...(filAriane.length
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonique}#fil`,
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
              ...filAriane.map((etape, i) => ({
                '@type': 'ListItem',
                position: i + 2,
                name: etape.nom,
                item: new URL(etape.lien, site.url).href,
              })),
            ],
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="alternate" hreflang="fr-fr" href={canonique} />
    <link rel="alternate" hreflang="fr" href={canonique} />
    <link rel="alternate" hreflang="x-default" href={canonique} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="author" content="Julien Duplouy" />
    <meta name="geo.region" content="FR-65" />
    <meta name="geo.placename" content={site.ville} />

    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <meta name="theme-color" content="#1C2E57" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(donneesCommunes)} />

    <meta property="og:type" content={typeOg} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageAbsolue} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a href="#contenu" class="saut-contenu">Aller au contenu</a>
    {pageConversion ? <EnteteNue /> : <Entete />}

    <main id="contenu">
      <slot />
    </main>

    <Pied />

    {
      barreMobile && (
        <div class="barre-mobile" data-barre-mobile aria-hidden="false">
          <div class="barre-mobile-texte">
            <strong>Diagnostic gratuit</strong>
            <span>7 minutes, score sur 100</span>
          </div>
          <a href="/diagnostic" class="btn btn-principal barre-mobile-btn">
            Je le veux
            <Icone nom="fleche" classe="fleche" />
          </a>
        </div>
      )
    }

    <script>
      // Apparitions au défilement
      const cibles = document.querySelectorAll<HTMLElement>('.reveal');
      const doux = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (doux || !('IntersectionObserver' in window)) {
        cibles.forEach((el) => el.classList.add('visible'));
      } else {
        const observateur = new IntersectionObserver(
          (entrees) => {
            entrees.forEach((entree) => {
              if (entree.isIntersecting) {
                entree.target.classList.add('visible');
                observateur.unobserve(entree.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        cibles.forEach((el) => observateur.observe(el));
      }

      // Barre d'appel à l'action mobile : apparaît une fois le premier écran passé
      const barre = document.querySelector<HTMLElement>('[data-barre-mobile]');
      if (barre) {
        const bascule = () => barre.classList.toggle('visible', window.scrollY > 620);
        bascule();
        window.addEventListener('scroll', bascule, { passive: true });
      }
    </script>

    <style>
      .barre-mobile {
        position: fixed;
        left: 0.75rem;
        right: 0.75rem;
        bottom: 0.75rem;
        z-index: 55;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.9rem;
        padding: 0.7rem 0.7rem 0.7rem 1.1rem;
        border: 1px solid var(--ligne);
        border-radius: var(--r-xl);
        background: rgba(255, 255, 255, 0.97);
        box-shadow: var(--ombre-l);
        opacity: 0;
        transform: translateY(130%);
        pointer-events: none;
        transition: opacity 320ms ease, transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
      }
      .barre-mobile.visible { opacity: 1; transform: none; pointer-events: auto; }

      .barre-mobile-texte { display: grid; line-height: 1.25; }
      .barre-mobile-texte strong { font-size: 0.92rem; }
      .barre-mobile-texte span { font-size: 0.76rem; color: var(--encre-3); }
      .barre-mobile-btn { min-height: 2.8rem; padding-inline: 1.1rem; font-size: 0.9rem; flex: none; }

      @media (min-width: 900px) {
        .barre-mobile { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        .barre-mobile { transition: none; }
      }
    </style>
  </body>
</html>
