---
import Icone from './Icone.astro';
import { site } from '../data/site.js';

interface Props {
  titre?: string;
  texte?: string;
  bouton?: string;
  lien?: string;
}

const {
  titre = 'Votre cabinet est-il facile à trouver et à réserver ?',
  texte = 'Quinze questions, sept minutes : votre score sur 100, ce qui vous manque pour remplir vos créneaux, et les trois priorités à traiter en premier. Gratuit, sans engagement — et vous gardez la synthèse.',
  bouton = 'Faire le diagnostic gratuit — 7 min',
  lien = '/diagnostic',
} = Astro.props;
---

<section class="bande">
  <span class="halo halo-anime bande-halo-1"></span>
  <span class="halo halo-anime-2 bande-halo-2"></span>

  <div class="rail bande-contenu">
    <div class="reveal">
      <span class="bande-etiquette">
        <span class="point"></span>
        Gratuit et sans engagement
      </span>
      <h2 class="bande-titre">{titre}</h2>
      <p class="bande-texte">{texte}</p>

      <div class="groupe-btn bande-actions">
        <a href={lien} class="btn btn-principal btn-large">
          {bouton}
          <Icone nom="fleche" classe="fleche" />
        </a>
        <a href="/rendez-vous" class="btn btn-clair btn-large">
          <Icone nom="video" />
          Échange découverte — 20 min, offert
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .bande {
    position: relative;
    overflow: hidden;
    margin-top: clamp(3rem, 8vw, 5rem);
    background: linear-gradient(150deg, #1C2E57 0%, #162447 55%, #0F1A33 100%);
    color: #F4F6FA;
  }
  .bande-halo-1 {
    width: 22rem; height: 22rem;
    top: -8rem; right: -6rem;
    background: rgba(217, 160, 106, 0.32);
  }
  .bande-halo-2 {
    width: 18rem; height: 18rem;
    bottom: -8rem; left: -5rem;
    background: rgba(192, 102, 60, 0.34);
  }

  .bande-contenu {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 8vw, 5rem);
  }
  .bande-contenu > * { max-width: 52rem; }

  .bande-etiquette {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.95rem;
    border-radius: var(--r-pilule);
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.12);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .bande-etiquette .point { background: var(--ambre); }

  .bande-titre {
    margin-top: 1.25rem;
    color: #FFFFFF;
    font-size: clamp(1.7rem, 4.6vw, 2.6rem);
  }
  .bande-texte {
    margin-top: 1.1rem;
    max-width: 44rem;
    color: rgba(242, 247, 243, 0.86);
    font-size: clamp(1rem, 2.2vw, 1.1rem);
    line-height: 1.7;
  }
  .bande-actions { margin-top: 2rem; }
</style>
