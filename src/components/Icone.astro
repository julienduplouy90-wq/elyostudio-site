const trace = traces[nom] ?? traces.etincelle;
const style = taille ? `width:${taille};height:${taille}` : undefined;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={classe}
  style={style}
  set:html={trace}
/>
