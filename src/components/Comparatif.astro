---
// Comparatif des alternatives réelles : ne rien faire, le faire soi-même,
// un freelance, ElyoStudio. Tableau sur grand écran, cartes empilées sur mobile.
import { comparatif } from '../data/site.js';

const { colonnes, lignes } = comparatif;
const derniere = colonnes.length - 1;
---

<div class="comparatif">
  <!-- Grand écran -->
  <div class="comparatif-cadre">
    <table class="comparatif-table">
      <caption class="visuellement-cache">
        Comparaison des façons d’obtenir un site de naturopathe : ne rien faire, le faire soi-même,
        passer par un freelance ou par ElyoStudio.
      </caption>
      <thead>
        <tr>
          <th scope="col"><span class="visuellement-cache">Critère</span></th>
          {
            colonnes.map((c, i) => (
              <th scope="col" class={i === derniere ? 'colonne-nous' : undefined}>
                {c}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          lignes.map((ligne) => (
            <tr>
              <th scope="row">{ligne.critere}</th>
              {ligne.valeurs.map((v, i) => (
                <td class={i === derniere ? 'colonne-nous' : undefined}>{v}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <!-- Mobile -->
  <div class="comparatif-cartes" aria-hidden="true">
    {
      colonnes.map((colonne, i) => (
        <article class:list={['comparatif-carte', { 'comparatif-carte-nous': i === derniere }]}>
          <h3>{colonne}</h3>
          <dl>
            {lignes.map((ligne) => (
              <>
                <dt>{ligne.critere}</dt>
                <dd>{ligne.valeurs[i]}</dd>
              </>
            ))}
          </dl>
        </article>
      ))
    }
  </div>
</div>

<style>
  .comparatif-cadre { display: none; }

  /* ---------- Cartes (mobile) ---------- */
  .comparatif-cartes { display: grid; gap: 1rem; }
  .comparatif-carte {
    padding: clamp(1.2rem, 3.4vw, 1.6rem);
    border: 1px solid var(--ligne);
    border-radius: var(--r-xl);
    background: var(--blanc);
    box-shadow: var(--ombre-s), var(--ombre-interne);
  }
  .comparatif-carte h3 { font-size: 1.15rem; }
  .comparatif-carte-nous {
    background: linear-gradient(165deg, #ffffff, var(--vert-clair));
    border-color: rgba(46, 90, 75, 0.28);
    box-shadow: var(--ombre-m), var(--ombre-interne);
  }
  .comparatif-carte-nous h3 { color: var(--vert); }

  .comparatif-carte dl { margin-top: 1rem; display: grid; gap: 0.7rem; }
  .comparatif-carte dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--encre-3);
  }
  .comparatif-carte dd {
    margin: 0.15rem 0 0;
    font-size: 0.98rem;
    color: var(--encre);
  }

  /* ---------- Tableau (grand écran) ---------- */
  @media (min-width: 900px) {
    .comparatif-cartes { display: none; }
    .comparatif-cadre {
      display: block;
      overflow-x: auto;
      border: 1px solid var(--ligne);
      border-radius: var(--r-xl);
      background: var(--blanc);
      box-shadow: var(--ombre-m), var(--ombre-interne);
    }

    .comparatif-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    .comparatif-table th,
    .comparatif-table td {
      padding: 1rem 1.1rem;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--ligne);
    }
    .comparatif-table tbody tr:last-child th,
    .comparatif-table tbody tr:last-child td { border-bottom: 0; }

    .comparatif-table thead th {
      font-family: var(--police-texte);
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--encre-3);
      background: var(--creme-2);
      border-bottom: 1px solid var(--ligne-forte);
    }

    .comparatif-table tbody th {
      font-family: var(--police-texte);
      font-weight: 600;
      font-size: 0.92rem;
      color: var(--encre);
      width: 22%;
      background: rgba(246, 238, 227, 0.5);
    }

    .comparatif-table td { color: var(--encre-2); }

    .comparatif-table .colonne-nous {
      background: linear-gradient(180deg, rgba(223, 234, 226, 0.55), rgba(223, 234, 226, 0.3));
      color: var(--encre);
      font-weight: 500;
    }
    .comparatif-table thead .colonne-nous {
      color: var(--vert);
      background: var(--vert-clair);
    }
    .comparatif-table tbody tr:last-child .colonne-nous { border-bottom-left-radius: var(--r-xl); }
  }
</style>
