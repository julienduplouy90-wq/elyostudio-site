---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import { site, prix, villes } from '../data/site.js';

const annee = new Date().getFullYear();
---

<footer class="pied">
  <div class="rail pied-haut">
    <div class="pied-marque">
      <a href="/" class="pied-logo"><Logo /></a>
      <p class="pied-promesse">{site.promesse}</p>
      <p class="pied-lieu">
        <Icone nom="position" /> {site.ville}, {site.region} — et partout en France, en visio.
      </p>
    </div>

    <nav class="pied-colonnes" aria-label="Pied de page">
      <div>
        <h2 class="pied-titre">Le studio</h2>
        <ul>
          <li><a href="/offre">L’accompagnement et le tarif</a></li>
          <li><a href="/methode">La méthode</a></li>
          <li><a href="/realisations">Réalisations</a></li>
          <li><a href="/a-propos">À propos</a></li>
        </ul>
      </div>
      <div>
        <h2 class="pied-titre">Avancer</h2>
        <ul>
          <li><a href="/demarrer">Démarrer</a></li>
          <li><a href="/diagnostic">Le diagnostic des 5 fondations</a></li>
          <li><a href="/audit-gratuit">Audit vidéo gratuit</a></li>
          <li><a href="/rendez-vous">Échange découverte</a></li>
          <li><a href="/blog">Le journal</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2 class="pied-titre">Par secteur</h2>
        <ul>
          <li><a href="/creation-site-internet-naturopathe">Création de site pour naturopathe</a></li>
          {villes.map((v) => (
            <li>
              <a href={v.lien}>Naturopathe à {v.nom}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="pied-titre">Contact</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:${site.telephoneLien}`}>{site.telephone}</a></li>
        </ul>
        <p class="pied-tarif">
          <strong>{prix.total}</strong> pour {prix.duree} — ou {prix.paiement3x} sans frais. Tarif fondateur, {prix.placesFondateur} places.
        </p>
      </div>
    </nav>
  </div>

  <div class="rail pied-bas">
    <p>© {annee} {site.nom} — {site.entreprise.raison}</p>
    <ul class="pied-legal">
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/confidentialite">Confidentialité</a></li>
      <li><a href="/cgv">CGV</a></li>
    </ul>
  </div>
</footer>

<style>
  .pied {
    position: relative;
    background:
      radial-gradient(90% 120% at 85% 0%, rgba(230, 236, 247, 0.6), transparent 55%),
      var(--creme-2);
    border-top: 1px solid var(--ligne);
  }

  .pied-haut {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
  }

  .pied-logo { text-decoration: none; }
  .pied-promesse {
    margin-top: 1.1rem;
    max-width: 30rem;
    color: var(--encre-2);
    font-size: 0.98rem;
  }
  .pied-lieu {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-size: 0.88rem;
    color: var(--encre-3);
  }
  .pied-lieu :global(svg) { width: 1rem; height: 1rem; color: var(--vert); }

  .pied-colonnes { display: grid; gap: 2rem; }
  .pied-titre {
    font-family: var(--police-texte);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vert);
  }
  .pied-colonnes ul { list-style: none; padding: 0; margin-top: 0.9rem; display: grid; gap: 0.6rem; }
  .pied-colonnes a {
    font-size: 0.95rem;
    color: var(--encre-2);
    text-decoration: none;
    transition: color var(--transition);
  }
  .pied-colonnes a:hover { color: var(--terre); }
  .pied-tarif {
    margin-top: 1.1rem;
    padding: 0.8rem 1rem;
    border-radius: var(--r-m);
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--ligne);
    box-shadow: var(--ombre-xs);
    font-size: 0.86rem;
    color: var(--encre-2);
  }
  .pied-tarif strong { color: var(--encre); }

  .pied-bas {
    display: grid;
    gap: 0.85rem;
    padding-block: 1.4rem 1.8rem;
    border-top: 1px solid var(--ligne);
    font-size: 0.85rem;
    color: var(--encre-3);
  }
  .pied-legal { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 1.1rem; }
  .pied-legal a { text-decoration: none; transition: color var(--transition); }
  .pied-legal a:hover { color: var(--terre); }

  @media (min-width: 640px) {
    .pied-colonnes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 960px) {
    .pied-haut { grid-template-columns: 0.9fr 1.6fr; gap: 3rem; }
    .pied-colonnes { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.6rem; }
    .pied-bas { grid-template-columns: 1fr auto; align-items: center; }
  }
</style>
