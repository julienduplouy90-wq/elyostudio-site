---
interface Props {
  surtitre: string;
  titre: string;
  chapeau?: string;
  etroit?: boolean;
}
const { surtitre, titre, chapeau, etroit = false } = Astro.props;
---

<section class="en-page">
  <span class="halo halo-anime en-page-halo"></span>
  <div class={etroit ? 'rail-etroit' : 'rail'}>
    <div class="en-page-contenu">
      <span class="surtitre reveal">{surtitre}</span>
      <h1 class="reveal" style="--delai: 80ms">{titre}</h1>
      {chapeau && <p class="chapeau reveal" style="--delai: 160ms">{chapeau}</p>}
      <div class="reveal" style="--delai: 240ms"><slot /></div>
    </div>
  </div>
</section>

<style>
  .en-page {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(100% 70% at 85% 0%, rgba(223, 234, 226, 0.85), transparent 62%),
      radial-gradient(80% 60% at 0% 0%, rgba(248, 229, 218, 0.7), transparent 60%),
      var(--creme);
  }
  .en-page-halo {
    width: 20rem; height: 20rem;
    top: -9rem; right: -7rem;
    background: rgba(232, 168, 92, 0.26);
  }
  .en-page-contenu {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 6vw, 3.5rem);
  }
  .en-page-contenu h1 { margin-top: 1.1rem; }
  .en-page-contenu .chapeau { margin-top: 1.3rem; }
</style>
