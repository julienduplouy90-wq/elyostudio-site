---
// Bloc tarif partagé par la page pivot et les pages villes.
import Icone from './Icone.astro';
import { prix, activation } from '../data/site.js';

interface Props {
  /** Ville citée dans la phrase d'introduction, si la page en concerne une. */
  ville?: string;
}
const { ville } = Astro.props;
---

<div class="bloc-tarif">
  <div class="bloc-tarif-prix">
    <div>
      <span class="bloc-tarif-libelle">Mise en place</span>
      <p class="bloc-tarif-montant">{prix.miseEnPlace}</p>
      <p class="bloc-tarif-note">Une fois, au démarrage. Site et domaine compris.</p>
    </div>
    <span class="bloc-tarif-plus" aria-hidden="true">puis</span>
    <div>
      <span class="bloc-tarif-libelle">Chaque mois</span>
      <p class="bloc-tarif-montant">{prix.essentiel}<small> ou {prix.croissance} / mois</small></p>
      <p class="bloc-tarif-note">Sans engagement de durée.</p>
    </div>
  </div>

  <div class="bloc-tarif-detail">
    <p class="bloc-tarif-intro">
      Le même tarif {ville ? `à ${ville} qu’ailleurs en France` : 'pour tout le monde'}, affiché sans
      devis préalable. Le site est compris dans la mise en place, avec tout ce qui l’entoure :
    </p>
    <ul class="liste-cochee">
      {activation.points.slice(0, 6).map((p) => <li>{p.titre}</li>)}
    </ul>
    <p class="bloc-tarif-mensuel">
      Puis chaque mois : suivi des demandes, améliorations du site et des messages, développement
      des avis et de la visibilité locale, une action de développement à la fois.
    </p>
    <a href="/offre" class="lien-fleche">
      Découvrir Elyo Croissance en détail
      <Icone nom="fleche" classe="fleche" />
    </a>
  </div>
</div>

<style>
  .bloc-tarif {
    display: grid;
    gap: 1.15rem;
    margin-top: 1.6rem;
  }

  .bloc-tarif-prix {
    display: grid;
    gap: 0.9rem;
    align-items: center;
    padding: clamp(1.3rem, 4vw, 1.8rem);
    border-radius: var(--r-xl);
    border: 1px solid rgba(192, 102, 60, 0.28);
    background: linear-gradient(165deg, #ffffff, #FBF4EE);
    box-shadow: var(--ombre-m), var(--ombre-interne);
  }
  .bloc-tarif-libelle {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vert);
  }
  .bloc-tarif-montant {
    margin-top: 0.35rem;
    font-family: var(--police-titre);
    font-size: clamp(2rem, 6vw, 2.6rem);
    font-weight: 600;
    line-height: 1;
  }
  .bloc-tarif-montant small { font-size: 0.95rem; font-weight: 500; color: var(--encre-3); }
  .bloc-tarif-note { margin-top: 0.5rem; font-size: 0.92rem; color: var(--encre-2); }
  .bloc-tarif-plus {
    justify-self: start;
    font-family: var(--police-titre);
    font-size: 1.5rem;
    color: var(--encre-3);
  }

  .bloc-tarif-detail {
    padding: clamp(1.3rem, 4vw, 1.8rem);
    border-radius: var(--r-xl);
    border: 1px solid var(--ligne);
    background: var(--blanc);
    box-shadow: var(--ombre-s), var(--ombre-interne);
  }
  .bloc-tarif-intro { margin-bottom: 1rem; color: var(--encre-2); font-size: 0.97rem; }
  .bloc-tarif-mensuel {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ligne);
    font-size: 0.95rem;
    color: var(--encre-2);
  }
  .bloc-tarif-detail .lien-fleche { margin-top: 1.2rem; }

  @media (min-width: 720px) {
    .bloc-tarif-prix { grid-template-columns: 1fr auto 1fr; gap: 1.4rem; }
    .bloc-tarif-plus { justify-self: center; }
  }
  @media (min-width: 1000px) {
    .bloc-tarif { grid-template-columns: 0.95fr 1.05fr; align-items: start; }
  }
</style>
