---
import Icone from './Icone.astro';
import Ghl from './Ghl.astro';
import { site } from '../data/site.js';

interface Props {
  type?: 'audit' | 'contact';
}
const { type = 'audit' } = Astro.props;

// Si un formulaire GoHighLevel est configuré, il remplace le formulaire
// natif : les demandes arrivent directement dans le CRM.
const formulaireGhl = Boolean(site.ghl?.formulaireId);

const endpoint = site.endpointFormulaire;
const sujet = type === 'audit' ? 'Demande d’audit vidéo gratuit' : 'Message depuis elyostudio.fr';
const bouton = type === 'audit' ? 'Recevoir mon audit gratuit' : 'Envoyer mon message';
---

{
  formulaireGhl ? (
    <Ghl type="formulaire" />
  ) : (
  <form
    class="formulaire carte reveal"
    method="post"
    action={endpoint || undefined}
    data-formulaire
    data-email={site.email}
    data-sujet={sujet}
    novalidate={false}
  >
    <input type="hidden" name="_sujet" value={sujet} />
    <p class="pot-de-miel" aria-hidden="true">
      <label for={`site-web-${type}`}>Laissez ce champ vide</label>
      <input id={`site-web-${type}`} type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </p>
  
    <div class="formulaire-grille">
      <div class="champ">
        <label for={`prenom-${type}`}>Prénom *</label>
        <input
          id={`prenom-${type}`}
          name="nom"
          type="text"
          required
          autocomplete="given-name"
          placeholder="Camille"
        />
      </div>
  
      <div class="champ">
        <label for={`email-${type}`}>Email *</label>
        <input
          id={`email-${type}`}
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="vous@exemple.fr"
        />
      </div>
  
      <div class="champ">
        <label for={`ville-${type}`}>Ville d’exercice{type === 'audit' ? ' *' : ''}</label>
        <input
          id={`ville-${type}`}
          name="ville"
          type="text"
          required={type === 'audit'}
          autocomplete="address-level2"
          placeholder="Tarbes"
        />
      </div>
  
      {
        type === 'contact' && (
          <div class="champ">
            <label for="tel-contact">Téléphone</label>
            <input id="tel-contact" name="telephone" type="tel" autocomplete="tel" placeholder="06 12 34 56 78" />
            <span class="aide">Facultatif, si vous préférez qu’on s’appelle.</span>
          </div>
        )
      }
  
      {
        type === 'audit' && (
          <div class="champ">
            <label for="site-actuel">Adresse de votre site</label>
            <input id="site-actuel" name="site" type="url" placeholder="https://…" />
            <span class="aide">Facultatif. Vous n’en avez pas encore ? C’est très bien aussi.</span>
          </div>
        )
      }
  
      <div class="champ champ-large">
        <label for={`message-${type}`}>{type === 'audit' ? 'Vos spécialités' : 'Votre message *'}</label>
        <textarea
          id={`message-${type}`}
          name="message"
          required={type === 'contact'}
          placeholder={
            type === 'audit'
              ? 'Facultatif. Par exemple : troubles digestifs et sommeil.'
              : 'Dites-moi en quelques lignes ce dont vous avez besoin.'
          }
        ></textarea>
      </div>
    </div>
  
    <label class="consentement">
      <input type="checkbox" name="consentement" required />
      <span>
        J’accepte que mes informations soient utilisées pour me recontacter. Elles ne sont ni revendues
        ni transmises à des tiers — voir la <a href="/confidentialite">politique de confidentialité</a>.
      </span>
    </label>
  
    <button type="submit" class="btn btn-principal btn-large formulaire-envoi">
      {bouton}
      <Icone nom="fleche" classe="fleche" />
    </button>
  
    <p class="formulaire-note">
      <Icone nom="bouclier" />
      Réponse sous 48 heures ouvrées. Aucune newsletter automatique, aucun démarchage.
    </p>
  </form>
  )
}

<style>
  .formulaire {
    display: grid;
    gap: 1.35rem;
    border-radius: var(--r-xl);
    box-shadow: var(--ombre-m), var(--ombre-interne);
  }

  .formulaire-grille { display: grid; gap: 1.1rem; }
  @media (min-width: 640px) {
    .formulaire-grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .champ-large { grid-column: 1 / -1; }
  }

  .pot-de-miel {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consentement {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    font-size: 0.86rem;
    color: var(--encre-2);
  }
  .consentement input {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.18rem;
    accent-color: var(--vert);
  }
  .consentement a { color: var(--vert); }

  .formulaire-envoi { justify-self: stretch; }
  @media (min-width: 560px) { .formulaire-envoi { justify-self: start; } }

  .formulaire-note {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: var(--encre-3);
  }
  .formulaire-note :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--vert); flex: none; }
</style>

<script>
  // Sans service d'envoi configuré, le formulaire prépare un email pré-rempli.
  document.querySelectorAll<HTMLFormElement>('[data-formulaire]').forEach((form) => {
    if (form.getAttribute('action')) return;

    form.addEventListener('submit', (evenement) => {
      evenement.preventDefault();
      if (!form.reportValidity()) return;

      const donnees = new FormData(form);
      if (donnees.get('_gotcha')) return;

      const etiquettes: Record<string, string> = {
        nom: 'Prénom',
        email: 'Email',
        telephone: 'Téléphone',
        ville: 'Ville',
        site: 'Site actuel',
        message: 'Spécialités / message',
      };

      const lignes = Object.entries(etiquettes)
        .map(([cle, libelle]) => {
          const valeur = String(donnees.get(cle) ?? '').trim();
          return valeur ? `${libelle} : ${valeur}` : null;
        })
        .filter(Boolean)
        .join('\n');

      const destinataire = form.dataset.email ?? '';
      const sujet = encodeURIComponent(form.dataset.sujet ?? 'Message depuis elyostudio.fr');
      const corps = encodeURIComponent(lignes);

      window.location.href = `mailto:${destinataire}?subject=${sujet}&body=${corps}`;
      window.setTimeout(() => {
        window.location.href = '/merci';
      }, 900);
    });
  });
</script>
