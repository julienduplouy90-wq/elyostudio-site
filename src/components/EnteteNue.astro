---
// En-tête réduit des pages de conversion : le logo, rien d'autre.
// Pas de menu, donc pas de sortie possible avant d'avoir rempli le formulaire.
import Logo from './Logo.astro';
---

<header class="entete-nue">
  <div class="rail entete-nue-rail">
    <a href="/" class="entete-nue-logo">
      <Logo baseline />
    </a>
  </div>
</header>

<style>
  .entete-nue {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--ligne);
  }
  .entete-nue-rail {
    display: flex;
    align-items: center;
    min-height: 4.5rem;
  }
  .entete-nue-logo { text-decoration: none; }
</style>
