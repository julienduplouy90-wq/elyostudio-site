---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import Icone from '../components/Icone.astro';
import BandeCta from '../components/BandeCta.astro';
import {
  site,
  prix,
  activation,
  mensuel,
  formules,
  nonInclus,
  pourQui,
  pasPour,
  engagements,
  faqsOffre,
  lienDemarrer,
} from '../data/site.js';

const titre = 'Elyo Croissance : site et visibilité locale | ElyoStudio';
const description = `Site professionnel, prise de rendez-vous, relances et référencement local pour thérapeutes et coachs. ${prix.activation} puis ${prix.mensuel}/mois.`;

const donnees = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${site.url}/offre#faq`,
      mainEntity: faqsOffre.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Service',
      '@id': `${site.url}/offre#croissance`,
      name: 'Elyo Croissance',
      serviceType:
        'Site internet, prise de rendez-vous en ligne, référencement local et accompagnement à la visibilité',
      description:
        'Accompagnement pour thérapeutes, psychopraticiens, coachs, énergéticiens, professeurs de yoga et professionnels de l’accompagnement : un site crédible, un système de rendez-vous et de relances, une visibilité locale installée, puis un suivi mensuel pour développer l’activité.',
      provider: { '@id': `${site.url}/#studio` },
      areaServed: { '@type': 'Country', name: 'France' },
      audience: {
        '@type': 'Audience',
        audienceType:
          'Thérapeutes, psychopraticiens, coachs, énergéticiens, professeurs de yoga et professionnels de l’accompagnement',
      },
      offers: [
        {
          '@type': 'Offer',
          name: 'Elyo Croissance — activation',
          price: '690',
          priceCurrency: 'EUR',
          url: `${site.url}/offre`,
          description: `Activation ${prix.activation}, puis ${prix.mensuel} par mois pendant ${prix.duree}.`,
        },
        {
          '@type': 'Offer',
          name: 'Elyo Croissance — suivi mensuel',
          price: '149',
          priceCurrency: 'EUR',
          url: `${site.url}/offre#suite`,
        },
      ],
    },
  ],
};
---

<Base titre={titre} description={description} filAriane={[{ nom: 'Elyo Croissance', lien: '/offre' }]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(donnees)} />

  <EnPage
    surtitre="Elyo Croissance"
    titre="Un site crédible, un système de rendez-vous, puis un accompagnement pour développer votre activité"
    chapeau="On installe d’abord les fondations : votre message au clair, un site professionnel, la prise de rendez-vous et la visibilité locale. Ensuite, chaque mois, on fait évoluer ce qui compte — une chose à la fois, sans vous éparpiller."
  >
    <div class="groupe-btn marge-haut">
      <a href={lienDemarrer} class="btn btn-principal btn-large">
        Voir si Elyo Croissance est adapté à mon activité
        <Icone nom="fleche" classe="fleche" />
      </a>
      <a href="/rendez-vous" class="btn btn-secondaire btn-large">Demander un échange découverte</a>
    </div>
  </EnPage>

  <!-- L'activation -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">{activation.surtitre}</span>
        <h2>{activation.titre}</h2>
        <p class="chapeau">{activation.texte}</p>
      </div>

      <div class="grille grille-4 marge-haut-grand">
        {
          activation.points.map((p, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 60}ms`}>
              <span class="pastille"><Icone nom={p.icone} /></span>
              <h3>{p.titre}</h3>
              <p>{p.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Le suivi mensuel -->
  <section class="section section-sombre" id="mensuel">
    <span class="halo halo-anime direct-halo"></span>
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre surtitre-clair">{mensuel.surtitre}</span>
        <h2 class="titre-clair">{mensuel.titre}</h2>
        <p class="chapeau chapeau-clair">{mensuel.texte}</p>
      </div>

      <div class="mensuel-grille marge-haut-grand">
        {
          mensuel.points.map((p, i) => (
            <article class="mensuel-carte reveal" style={`--delai: ${i * 70}ms`}>
              <span class="direct-icone"><Icone nom={p.icone} /></span>
              <div>
                <h3>{p.titre}</h3>
                <p>{p.texte}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>  <!-- Tarif -->
  <section class="section section-teintee" id="tarif">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Le tarif</span>
        <h2>Ce que coûte la mise en place complète</h2>
        <p class="chapeau">
          Une activation qui installe tout, puis un accompagnement mensuel pendant {prix.duree}.
          Le site est compris dans l’activation : il n’y a pas de facture séparée.
        </p>
      </div>

      <div class="deux-temps marge-haut-grand">
        <article class="temps temps-vedette reveal">
          <span class="temps-libelle">Activation</span>
          <p class="temps-prix">{prix.activation}</p>
          <p class="temps-note">
            Une fois, au démarrage. Message, site, rendez-vous en ligne, relances, fiche Google,
            mesure et vérifications.
          </p>
        </article>
        <span class="temps-plus" aria-hidden="true">puis</span>
        <article class="temps reveal" style="--delai: 90ms">
          <span class="temps-libelle">Accompagnement</span>
          <p class="temps-prix">{prix.mensuel}<small> / mois</small></p>
          <p class="temps-note">Pendant {prix.duree}. Suivi, améliorations, visibilité locale et actions de développement.</p>
        </article>
      </div>

      <p class="tarif-somme reveal">
        Soit <strong>{prix.total}</strong> pour la phase initiale complète.
      </p>

      <div class="groupe-btn tarif-actions reveal">
        <a href={lienDemarrer} class="btn btn-principal btn-large">
          Voir si Elyo Croissance est adapté à mon activité
          <Icone nom="fleche" classe="fleche" />
        </a>
        <a href="/rendez-vous" class="btn btn-secondaire btn-large">Demander un échange découverte</a>
      </div>

      <p class="tarif-mention reveal">
        Les outils tiers et les éventuels budgets publicitaires restent à votre charge.
      </p>
    </div>
  </section>

  <!-- Après les six mois -->
  <section class="section" id="suite">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Après les {prix.duree}</span>
        <h2>Vous restez libre de choisir la suite</h2>
        <p class="chapeau">
          Rien ne se reconduit automatiquement. Vous pouvez tout garder et continuer seul, ou
          choisir la formule qui correspond à ce dont vous avez besoin à ce moment-là.
        </p>
      </div>

      <div class="formules marge-haut-grand">
        {
          formules.map((f, i) => (
            <article
              class={`formule carte reveal${f.vedette ? ' formule-vedette' : ''}`}
              style={`--delai: ${i * 80}ms`}
            >
              {f.vedette && <span class="formule-ruban">La plus choisie</span>}
              <h3 class="formule-nom">{f.nom}</h3>
              <p class="formule-prix">
                {f.prix}<small> / mois</small>
              </p>
              <p class="formule-resume">{f.resume}</p>
              <ul class="liste-cochee formule-points">
                {f.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <p class="tarif-mention reveal">
        Elyo Direct, c’est un accès humain direct et cadré — des réponses de ma part quand vous en
        avez besoin, pas un volume d’exécution illimité.
      </p>
    </div>
  </section>

  <!-- Pour qui / pas adapté -->
  <section class="section section-teintee" id="pour-qui">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Pour qui</span>
        <h2>Les professionnels de l’accompagnement, en lancement ou déjà installés</h2>
        <p class="chapeau">
          Le vocabulaire change d’un métier à l’autre — patients, élèves, clients — mais la
          mécanique est la même : être trouvé, être compris, transformer cette visibilité en
          demandes de rendez-vous.
        </p>
      </div>
      <div class="pourqui-cartes marge-haut-grand">
        <article class="carte reveal">
          <h3>Elyo Croissance est fait pour vous si…</h3>
          <ul class="liste-cochee pourqui-liste">
            {pourQui.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="carte reveal" style="--delai: 90ms">
          <h3>Il ne sera probablement pas adapté si…</h3>
          <ul class="pasadapte-liste pourqui-liste">
            {pasPour.map((item) => <li>{item}</li>)}
          </ul>
          <p class="pourqui-note">
            Ce n’est pas un jugement — c’est pour que l’accompagnement serve vraiment à ceux qui en
            attendent ce qu’il apporte.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Ce qui n'est pas inclus -->
  <section class="section">
    <div class="rail rail-etroit">
      <div class="entete-section reveal">
        <span class="surtitre">En toute clarté</span>
        <h2>Ce qui n’est pas inclus</h2>
        <p class="chapeau">
          Autant le dire tout de suite, plutôt que de le découvrir en cours de route.
        </p>
      </div>
      <ul class="pasadapte-liste noninclus-liste reveal">
        {nonInclus.map((item) => <li>{item}</li>)}
      </ul>
      <p class="pourqui-note reveal">
        Certaines de ces demandes peuvent faire l’objet d’un devis à part. Nous en parlons si le
        besoin se présente.
      </p>
    </div>
  </section>

  <!-- Engagements -->
  <section class="section section-teintee">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Les garde-fous</span>
        <h2>Quatre choses qui ne bougent pas</h2>
      </div>
      <div class="grille grille-4 marge-haut-grand">
        {
          engagements.map((e, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 70}ms`}>
              <span class="pastille"><Icone nom={e.icone} /></span>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Questions -->
  <section class="section">
    <div class="rail-etroit">
      <div class="entete-section reveal">
        <span class="surtitre">Questions sur Elyo Croissance</span>
        <h2>Ce que l’on me demande avant de démarrer</h2>
      </div>

      <div class="faq marge-haut-grand">
        {
          faqsOffre.map((f, i) => (
            <details class="reveal" style={`--delai: ${i * 45}ms`} open={i === 0}>
              <summary>{f.q}</summary>
              <p class="reponse">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <BandeCta
    titre="Pas sûr que ce soit le bon moment ?"
    texte="Faites le point sur votre visibilité : en sept minutes, le diagnostic vous dit où en est votre activité et par quoi commencer. Puis, si vous voulez en parler, l’échange découverte est offert."
  />
</Base>

<style>
  .marge-haut { margin-top: 1.8rem; }
  .marge-haut-grand { margin-top: clamp(2rem, 5vw, 3rem); }

  /* Section sombre — suivi mensuel */
  .section-sombre {
    position: relative;
    overflow: hidden;
    color: #ffffff;
    background: linear-gradient(150deg, #0f1a33 0%, #1c2e57 60%, #22396b 100%);
  }
  .direct-halo {
    width: 26rem;
    height: 26rem;
    top: -10rem;
    right: -8rem;
    background: rgba(217, 160, 106, 0.22);
  }
  .section-sombre .rail { position: relative; z-index: 1; }
  .surtitre-clair { color: var(--ambre); }
  .titre-clair { color: #ffffff; }
  .chapeau-clair { color: rgba(255, 255, 255, 0.82); }

  .mensuel-grille { display: grid; gap: 0.9rem; }
  .mensuel-carte {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.15rem 1.25rem;
    border-radius: var(--r-l);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
  }
  .direct-icone {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--r-m);
    background: rgba(217, 160, 106, 0.18);
    color: var(--ambre);
  }
  .direct-icone :global(svg) { width: 1.3rem; height: 1.3rem; }
  .mensuel-carte h3 { color: #ffffff; font-size: 1.05rem; margin-bottom: 0.3rem; }
  .mensuel-carte p { color: rgba(255, 255, 255, 0.76); font-size: 0.93rem; }
  @media (min-width: 760px) { .mensuel-grille { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; } }

  /* Tarif */
  .deux-temps { display: grid; gap: 0.9rem; align-items: stretch; }
  .temps {
    padding: clamp(1.3rem, 4vw, 1.9rem);
    border-radius: var(--r-xl);
    border: 1px solid var(--ligne);
    background: var(--blanc);
    box-shadow: var(--ombre-m);
  }
  .temps-vedette { border-color: rgba(192, 102, 60, 0.35); box-shadow: var(--ombre-l); }
  .temps-libelle {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vert);
  }
  .temps-prix {
    margin-top: 0.5rem;
    font-family: var(--police-titre);
    font-size: clamp(2.3rem, 7vw, 3rem);
    font-weight: 600;
    line-height: 1;
  }
  .temps-prix small { font-size: 1rem; font-weight: 500; color: var(--encre-3); }
  .temps-note { margin-top: 0.7rem; color: var(--encre-2); font-size: 0.95rem; }
  .temps-plus {
    display: grid;
    place-items: center;
    font-family: var(--police-titre);
    font-size: 1.2rem;
    font-style: italic;
    color: var(--encre-3);
  }
  @media (min-width: 800px) { .deux-temps { grid-template-columns: 1fr auto 1fr; gap: 1.2rem; } }

  .tarif-somme {
    margin-top: 1.4rem;
    font-size: 1.05rem;
    color: var(--encre-2);
  }
  .tarif-somme strong { color: var(--encre); font-family: var(--police-titre); font-size: 1.2rem; }
  .tarif-actions { margin-top: 1.6rem; }
  .tarif-mention { margin-top: 1.1rem; font-size: 0.86rem; color: var(--encre-3); max-width: 46rem; }

  /* Formules */
  .formules { display: grid; gap: 1.1rem; align-items: stretch; }
  .formule { position: relative; display: flex; flex-direction: column; }
  .formule-vedette { border-color: rgba(192, 102, 60, 0.35); box-shadow: var(--ombre-l); }
  .formule-ruban {
    position: absolute;
    top: -0.8rem;
    left: clamp(1.2rem, 4vw, 1.8rem);
    padding: 0.3rem 0.85rem;
    border-radius: var(--r-pilule);
    background: linear-gradient(150deg, var(--terre), var(--terre-2));
    color: #fff6f1;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .formule-nom { font-size: 1.2rem; }
  .formule-prix {
    margin-top: 0.4rem;
    font-family: var(--police-titre);
    font-size: clamp(1.9rem, 5vw, 2.3rem);
    font-weight: 600;
    line-height: 1;
    color: var(--vert);
  }
  .formule-prix small { font-size: 0.9rem; font-weight: 500; color: var(--encre-3); }
  .formule-resume { margin-top: 0.7rem; color: var(--encre-2); font-size: 0.95rem; }
  .formule-points {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ligne);
    gap: 0.7rem;
    font-size: 0.95rem;
  }
  @media (min-width: 900px) { .formules { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; } }

  /* Pour qui / pas adapté */
  .pourqui-cartes { display: grid; gap: 1.15rem; align-items: stretch; }
  .pourqui-cartes .carte { display: flex; flex-direction: column; }
  .pourqui-cartes h3 { margin-bottom: 1rem; font-size: 1.15rem; }
  .pourqui-liste { gap: 0.8rem; font-size: 0.99rem; }
  .pasadapte-liste { list-style: none; padding: 0; display: grid; color: var(--encre-2); }
  .pasadapte-liste li { position: relative; padding-left: 1.6rem; }
  .pasadapte-liste li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.62em;
    width: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: var(--encre-3);
  }
  .pourqui-note { margin-top: auto; padding-top: 1.2rem; font-size: 0.9rem; color: var(--encre-3); }
  @media (min-width: 900px) { .pourqui-cartes { grid-template-columns: 1fr 1fr; gap: 1.4rem; } }

  .noninclus-liste { margin-top: 1.6rem; gap: 0.8rem; font-size: 1rem; }
</style>
