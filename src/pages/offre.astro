---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import Icone from '../components/Icone.astro';
import BandeCta from '../components/BandeCta.astro';
import { site, prix, phases, elyoDirect, pourQui, pasPour, engagements, faqsOffre, lienDemarrer } from '../data/site.js';

const titre = `Elyo Direct : ${prix.duree} d’accompagnement — ${prix.total} | ElyoStudio`;
const description = `Elyo Direct : positionnement, site, fiche Google, référencement local, acquisition et accès direct pendant ${prix.duree}. ${prix.total} ou ${prix.paiement3x}, tarif fondateur.`;

const donnees = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${site.url}/offre#faq`,
      mainEntity: faqsOffre.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Product',
      '@id': `${site.url}/offre#accompagnement`,
      name: 'Elyo Direct — accompagnement de 6 mois',
      description:
        'Accompagnement de développement de cabinet pour thérapeutes, psychopraticiens, coachs, professeurs de yoga, énergéticiens, naturopathes et praticiens bien-être : positionnement, site, visibilité locale, acquisition, suivi et accès direct pendant 6 mois.',
      brand: { '@id': `${site.url}/#studio` },
      offers: {
        '@type': 'Offer',
        price: '990',
        priceCurrency: 'EUR',
        availability: 'https://schema.org/LimitedAvailability',
        url: `${site.url}/offre`,
        description: `${prix.total} comptant, ou ${prix.paiement3x} sans frais. Tarif fondateur, ${prix.placesFondateur} places.`,
      },
    },
  ],
};
---

<Base titre={titre} description={description} filAriane={[{ nom: "L’accompagnement", lien: "/offre" }]}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(donnees)} />

  <EnPage
    surtitre="Elyo Direct — l’accompagnement"
    titre="Six mois pour construire le système qui développe votre cabinet"
    chapeau="Clarifier, construire, être trouvé, développer, ajuster : cinq étapes sur six mois, dans le bon ordre. Et pendant toute la durée, un accès direct : quelqu’un à vos côtés, sans compteur."
  >
    <div class="groupe-btn marge-haut">
      <a href={lienDemarrer} class="btn btn-principal btn-large">
        Démarrer Elyo Direct
        <Icone nom="fleche" classe="fleche" />
      </a>
      <a href="/rendez-vous" class="btn btn-secondaire btn-large">J’ai besoin d’en parler d’abord</a>
    </div>
  </EnPage>

  <!-- Les quatre phases -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Ce qui est mis en place</span>
        <h2>Cinq étapes, dans le bon ordre</h2>
        <p class="chapeau">
          Je ne commence pas par le site. Je commence par comprendre votre cabinet, puis je
          construis chaque brique sur la précédente — une logique de progression, pas une liste
          de prestations.
        </p>
      </div>

      <div class="phases marge-haut-grand">
        {
          phases.map((p, i) => (
            <article class="phase carte reveal" style={`--delai: ${i * 80}ms`}>
              <div class="phase-entete">
                <span class="pastille"><Icone nom={p.icone} /></span>
                <div>
                  <span class="phase-periode">{p.periode}</span>
                  <h3>{p.titre}</h3>
                </div>
              </div>
              <p class="phase-texte">{p.texte}</p>
              <ul class="liste-cochee phase-points">
                {p.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Elyo Direct -->
  <section class="section section-sombre" id="elyo-direct">
    <span class="halo halo-anime direct-halo"></span>
    <div class="rail direct-rail">
      <div class="direct-texte reveal">
        <span class="surtitre surtitre-clair">L’accès direct — compris pendant {prix.duree}</span>
        <h2>{elyoDirect.accroche}</h2>
        <p class="direct-chapeau">
          Le principe n’est pas la visio illimitée. C’est que vous ne restiez jamais bloqué seul :
          vous me sollicitez quand vous en avez besoin, et je vous réponds par le canal le plus
          efficace pour la situation.
        </p>
        <ul class="direct-situations">
          {elyoDirect.situations.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="direct-canaux">
        {
          elyoDirect.canaux.map((c, i) => (
            <article class="direct-canal reveal" style={`--delai: ${i * 80}ms`}>
              <span class="direct-icone"><Icone nom={c.icone} /></span>
              <div>
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pour qui -->
  <section class="section" id="pour-qui">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Pour qui</span>
        <h2>Les professionnels de l’accompagnement, en lancement ou déjà installés</h2>
        <p class="chapeau">
          Le vocabulaire change d’un métier à l’autre — patients, élèves, clients — mais la
          mécanique est la même : être trouvé, être compris, transformer cette visibilité en
          rendez-vous.
        </p>
      </div>
      <div class="pourqui-cartes marge-haut-grand">
        <article class="carte reveal">
          <h3>Elyo Direct est fait pour vous si…</h3>
          <ul class="liste-cochee pourqui-liste">
            {pourQui.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="carte reveal" style="--delai: 90ms">
          <h3>Il ne sera probablement pas adapté si…</h3>
          <ul class="pasadapte-liste pourqui-liste">
            {pasPour.map((item) => <li>{item}</li>)}
          </ul>
          <p class="pourqui-note">
            Ce n’est pas un jugement — c’est pour que les six mois servent vraiment à ceux qui en
            attendent ce qu’ils apportent.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Tarif fondateur -->
  <section class="section section-teintee" id="tarif">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Tarif fondateur</span>
        <h2>{prix.total} pour {prix.duree}, réservé aux {prix.placesFondateur} premiers cabinets</h2>
        <p class="chapeau">
          Elyo Direct est en phase de lancement : je travaille avec mes premiers cabinets pour
          affiner la méthode, mesurer précisément les résultats et construire mes premiers
          retours d’expérience. En contrepartie, les {prix.placesFondateur} premiers bénéficient de ce tarif — il
          passera ensuite à {prix.tarifSuivant}. Ce n’est pas une promotion artificielle : c’est le
          prix de la phase de lancement d’ElyoStudio.
        </p>
      </div>

      <div class="deux-temps marge-haut-grand">
        <article class="temps temps-vedette reveal">
          <span class="temps-libelle">Comptant</span>
          <p class="temps-prix">{prix.total}</p>
          <p class="temps-note">Les {prix.duree} complets, accès direct compris. Rien d’autre à payer à ElyoStudio.</p>
        </article>
        <span class="temps-plus" aria-hidden="true">ou</span>
        <article class="temps reveal" style="--delai: 90ms">
          <span class="temps-libelle">En trois fois, sans frais</span>
          <p class="temps-prix">{prix.paiement3x}</p>
          <p class="temps-note">Le même montant, réparti sur trois mois. Rien de plus à la fin.</p>
        </article>
      </div>

      <div class="groupe-btn tarif-actions reveal">
        <a href={lienDemarrer} class="btn btn-principal btn-large">
          Démarrer — {prix.total}
          <Icone nom="fleche" classe="fleche" />
        </a>
        <a href="/rendez-vous" class="btn btn-secondaire btn-large">Échange découverte</a>
      </div>
      <p class="tarif-mention reveal">
        Les budgets publicitaires éventuels et les outils tiers (agenda en ligne, emailing,
        hébergement après la première année) restent à votre charge.
      </p>
      <p class="tarif-mention reveal">
        <strong>Garantie :</strong> pas convaincu après le rendez-vous de lancement ? Je vous
        rembourse intégralement, sans condition.
      </p>
    </div>
  </section>

  <!-- Engagements -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Les garde-fous</span>
        <h2>Cinq choses qui ne bougent pas</h2>
      </div>
      <div class="grille grille-3 marge-haut-grand">
        {
          engagements.map((e, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 70}ms`}>
              <span class="pastille"><Icone nom={e.icone} /></span>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Questions -->
  <section class="section section-teintee">
    <div class="rail-etroit">
      <div class="entete-section reveal">
        <span class="surtitre">Questions sur Elyo Direct</span>
        <h2>Ce que l’on me demande avant de démarrer</h2>
      </div>

      <div class="faq marge-haut-grand">
        {
          faqsOffre.map((f, i) => (
            <details class="reveal" style={`--delai: ${i * 45}ms`} open={i === 0}>
              <summary>{f.q}</summary>
              <p class="reponse">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <BandeCta
    titre="Pas sûr que ce soit le bon moment ?"
    texte="Faites le diagnostic des 5 fondations : en sept minutes, vous saurez où en est votre cabinet et par quoi commencer. Puis, si vous voulez en parler, l’échange découverte est offert."
  />
</Base>

<style>
  .marge-haut { margin-top: 1.8rem; }
  .marge-haut-grand { margin-top: clamp(2rem, 5vw, 3rem); }

  /* Phases */
  .phases { display: grid; gap: 1.15rem; }
  .phase { display: grid; gap: 0.9rem; }
  .phase-entete { display: flex; gap: 1rem; align-items: center; }
  .phase-entete .pastille { margin: 0; flex: none; }
  .phase-periode {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terre);
    margin-bottom: 0.2rem;
  }
  .phase-texte { color: var(--encre-2); }
  .phase-points { gap: 0.6rem; font-size: 0.95rem; }
  @media (min-width: 860px) {
    .phases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Nombre impair d'étapes : la dernière est centrée sous les deux colonnes. */
    .phase:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      width: calc(50% - 0.575rem);
      margin-inline: auto;
    }
  }

  /* Elyo Direct */
  .section-sombre {
    position: relative;
    overflow: hidden;
    color: #FFFFFF;
    background: linear-gradient(150deg, #0F1A33 0%, #1C2E57 60%, #22396B 100%);
  }
  .direct-halo { width: 26rem; height: 26rem; top: -10rem; right: -8rem; background: rgba(217, 160, 106, 0.22); }
  .direct-rail { position: relative; z-index: 1; display: grid; gap: clamp(2rem, 5vw, 3.5rem); }
  .surtitre-clair { color: var(--ambre); }
  .direct-texte h2 { color: #FFFFFF; }
  .direct-chapeau { margin-top: 1.1rem; max-width: 34rem; color: rgba(255, 255, 255, 0.82); line-height: 1.7; }
  .direct-situations { list-style: none; padding: 0; margin-top: 1.4rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .direct-situations li {
    padding: 0.45rem 0.9rem;
    border-radius: var(--r-pilule);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.88rem;
  }
  .direct-canaux { display: grid; gap: 0.9rem; }
  .direct-canal {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.1rem 1.2rem;
    border-radius: var(--r-l);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
  }
  .direct-icone {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--r-m);
    background: rgba(217, 160, 106, 0.18);
    color: var(--ambre);
  }
  .direct-icone :global(svg) { width: 1.3rem; height: 1.3rem; }
  .direct-canal h3 { color: #FFFFFF; font-size: 1.05rem; margin-bottom: 0.3rem; }
  .direct-canal p { color: rgba(255, 255, 255, 0.76); font-size: 0.93rem; }
  @media (min-width: 960px) { .direct-rail { grid-template-columns: 1.1fr 0.9fr; align-items: center; } }

  /* Pour qui / pas adapté */
  .pourqui-cartes { display: grid; gap: 1.15rem; align-items: stretch; }
  .pourqui-cartes .carte { display: flex; flex-direction: column; }
  .pourqui-cartes h3 { margin-bottom: 1rem; font-size: 1.15rem; }
  .pourqui-liste { gap: 0.8rem; font-size: 0.99rem; }
  .pasadapte-liste { list-style: none; padding: 0; display: grid; color: var(--encre-2); }
  .pasadapte-liste li { position: relative; padding-left: 1.6rem; }
  .pasadapte-liste li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.62em;
    width: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: var(--encre-3);
  }
  .pourqui-note { margin-top: auto; padding-top: 1.2rem; font-size: 0.9rem; color: var(--encre-3); }
  @media (min-width: 900px) { .pourqui-cartes { grid-template-columns: 1fr 1fr; gap: 1.4rem; } }

  /* Tarif */
  .deux-temps { display: grid; gap: 0.9rem; align-items: stretch; }
  .temps {
    padding: clamp(1.3rem, 4vw, 1.9rem);
    border-radius: var(--r-xl);
    border: 1px solid var(--ligne);
    background: var(--blanc);
    box-shadow: var(--ombre-m);
  }
  .temps-vedette { border-color: rgba(192, 102, 60, 0.35); box-shadow: var(--ombre-l); }
  .temps-libelle { font-size: 0.76rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--vert); }
  .temps-prix { margin-top: 0.5rem; font-family: var(--police-titre); font-size: clamp(2.3rem, 7vw, 3rem); font-weight: 600; line-height: 1; }
  .temps-note { margin-top: 0.7rem; color: var(--encre-2); font-size: 0.95rem; }
  .temps-plus { display: grid; place-items: center; font-family: var(--police-titre); font-size: 1.3rem; font-style: italic; color: var(--encre-3); }
  @media (min-width: 800px) { .deux-temps { grid-template-columns: 1fr auto 1fr; gap: 1.2rem; } }
  .tarif-actions { margin-top: 1.6rem; }
  .tarif-mention { margin-top: 1rem; font-size: 0.86rem; color: var(--encre-3); max-width: 44rem; }
</style>
