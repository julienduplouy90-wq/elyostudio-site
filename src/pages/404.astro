---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';

const titre = 'Page introuvable | Elyostudio';
const description = 'Cette page n’existe pas ou plus.';
---

<Base titre={titre} description={description} noindex barreMobile={false}>
  <section class="erreur">
    <div class="rail-etroit erreur-contenu">
      <span class="erreur-code reveal">404</span>
      <h1 class="reveal" style="--delai: 80ms">Cette page a changé d’adresse</h1>
      <p class="chapeau reveal" style="--delai: 160ms">
        Le lien est peut-être ancien, ou la page a été renommée. Voici par où reprendre.
      </p>

      <div class="groupe-btn reveal" style="--delai: 240ms">
        <a href="/" class="btn btn-principal btn-large">
          Retour à l’accueil
          <Icone nom="fleche" classe="fleche" />
        </a>
        <a href="/offre" class="btn btn-secondaire btn-large">Voir l’offre</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .erreur {
    background:
      radial-gradient(100% 70% at 50% 0%, rgba(248, 229, 218, 0.8), transparent 65%),
      var(--creme);
  }
  .erreur-contenu { padding-block: clamp(3.5rem, 12vw, 7rem); text-align: center; }
  .erreur-code {
    font-family: var(--police-titre);
    font-size: clamp(3.5rem, 14vw, 6rem);
    font-weight: 600;
    line-height: 1;
    color: var(--terre);
    opacity: 0.55;
  }
  .erreur-contenu h1 { margin-top: 0.5rem; }
  .erreur-contenu .chapeau { margin-top: 1.1rem; }
  .erreur-contenu .groupe-btn { margin-top: 2rem; justify-content: center; }
</style>
