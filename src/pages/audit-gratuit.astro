---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import Icone from '../components/Icone.astro';
import Formulaire from '../components/Formulaire.astro';
import { site } from '../data/site.js';

const titre = 'Audit vidéo gratuit de votre présence en ligne | Elyostudio';
const description =
  'Recevez sous 48 heures une vidéo de 5 à 8 minutes : ce que voit une personne qui cherche une naturopathe dans votre ville, ce qui vous coûte des rendez-vous, et par quoi commencer. Gratuit, sans engagement.';

const contenuAudit = [
  {
    icone: 'recherche',
    titre: 'Ce que Google montre de vous',
    texte:
      'Je tape les recherches que font vos futurs clients dans votre ville, et je vous montre ce qui sort — vous, ou quelqu’un d’autre.',
  },
  {
    icone: 'mobile',
    titre: 'Votre site vu depuis un téléphone',
    texte:
      'Je parcours votre site comme le ferait une personne pressée, pouce sur l’écran, et je pointe ce qui la fait partir.',
  },
  {
    icone: 'position',
    titre: 'L’état de votre fiche Google',
    texte:
      'Informations manquantes, horaires, photos, avis : les points qui vous font perdre des places dans les résultats locaux.',
  },
  {
    icone: 'graphique',
    titre: 'Trois priorités, dans l’ordre',
    texte:
      'Ce que je ferais en premier, en deuxième, en troisième — que vous le fassiez vous-même ou avec moi.',
  },
];

const questions = [
  {
    q: 'C’est vraiment gratuit ?',
    a: 'Oui. Vous recevez la vidéo, vous en faites ce que vous voulez. C’est ma façon de montrer comment je travaille plutôt que de le raconter.',
  },
  {
    q: 'Et si je n’ai pas encore de site ?',
    a: 'C’est un très bon moment. J’analyse alors votre visibilité actuelle (fiche Google, annuaires, réseaux) et ce qu’il faudrait construire en priorité.',
  },
  {
    q: 'Combien de temps pour la recevoir ?',
    a: 'Sous 48 heures ouvrées, par email, sous forme d’un lien vidéo privé que vous pouvez regarder quand vous voulez.',
  },
];
---

<Base titre={titre} description={description} barreMobile={false}>
  <EnPage
    surtitre="Audit vidéo gratuit"
    titre="Je regarde votre présence en ligne, et je vous montre ce qui cloche"
    chapeau="Une vidéo de 5 à 8 minutes, enregistrée pour vous seule, où je parcours votre site et votre fiche Google en expliquant ce qui vous coûte des rendez-vous. Gratuit, sans engagement, sans relance commerciale."
  />

  <section class="section-serree">
    <div class="rail audit-rail">
      <div class="audit-form">
        <Formulaire type="audit" />
      </div>

      <aside class="audit-aside">
        <div class="carte carte-douce reveal">
          <span class="pastille"><Icone nom="video" /></span>
          <h2 class="aside-titre">Ce que contient la vidéo</h2>
          <ul class="aside-liste">
            {
              contenuAudit.map((c) => (
                <li>
                  <span class="aside-icone"><Icone nom={c.icone} /></span>
                  <span>
                    <strong>{c.titre}</strong>
                    <em>{c.texte}</em>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="carte reveal" style="--delai: 90ms">
          <h2 class="aside-titre">Vous préférez qu’on se parle ?</h2>
          <p class="texte-doux aside-texte">
            Un appel de 30 minutes, en visio, à l’heure qui vous arrange. Même principe : sans
            engagement et sans argumentaire de vente.
          </p>
          <a href={site.agenda} class="btn btn-secondaire btn-large" target="_blank" rel="noopener">
            <Icone nom="agenda" />
            Voir les créneaux disponibles
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-teintee">
    <div class="rail-etroit">
      <div class="entete-section reveal">
        <span class="surtitre">Trois questions</span>
        <h2>Avant de remplir le formulaire</h2>
      </div>
      <div class="faq marge-haut-grand">
        {
          questions.map((f, i) => (
            <details class="reveal" style={`--delai: ${i * 60}ms`} open={i === 0}>
              <summary>{f.q}</summary>
              <p class="reponse">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .marge-haut-grand { margin-top: clamp(1.6rem, 4vw, 2.4rem); }

  .audit-rail { display: grid; gap: 1.4rem; align-items: start; }
  .audit-aside { display: grid; gap: 1.15rem; }

  .aside-titre { font-size: 1.2rem; }
  .aside-texte { margin-block: 0.7rem 1.2rem; font-size: 0.95rem; }

  .aside-liste { list-style: none; padding: 0; margin-top: 1.1rem; display: grid; gap: 1rem; }
  .aside-liste li { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: start; }
  .aside-icone {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.7rem;
    background: var(--blanc);
    border: 1px solid var(--ligne);
    color: var(--vert);
    box-shadow: var(--ombre-xs);
  }
  .aside-icone :global(svg) { width: 1.1rem; height: 1.1rem; }
  .aside-liste strong { display: block; font-size: 0.95rem; }
  .aside-liste em { display: block; margin-top: 0.2rem; font-style: normal; font-size: 0.88rem; color: var(--encre-2); }

  @media (min-width: 960px) {
    .audit-rail { grid-template-columns: 1.35fr 0.85fr; gap: 1.8rem; }
  }
</style>
