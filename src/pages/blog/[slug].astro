---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import BandeCta from '../../components/BandeCta.astro';
import { site } from '../../data/site.js';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

type Props = { article: CollectionEntry<'articles'> };
const { article } = Astro.props;
const { Content, headings } = await render(article);

const tous = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const suggestions = tous.filter((a) => a.id !== article.id).slice(0, 2);

const dateFr = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const titre = `${article.data.titreSeo ?? article.data.titre} | ${site.nom}`;
const url = `${site.url}/blog/${article.id}`;
const sommaire = headings.filter((h) => h.depth === 2);
const nombreMots = article.body ? article.body.split(/\s+/).filter(Boolean).length : undefined;

const donnees = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: article.data.titre,
  description: article.data.description,
  articleSection: article.data.categorie,
  inLanguage: 'fr-FR',
  wordCount: nombreMots,
  datePublished: article.data.date.toISOString(),
  dateModified: article.data.date.toISOString(),
  image: `${site.url}/og-elyostudio.png`,
  author: { '@id': `${site.url}/#julien` },
  publisher: { '@id': `${site.url}/#studio` },
  isPartOf: { '@id': `${site.url}/#site` },
  mainEntityOfPage: url,
};
---

<Base
  titre={titre}
  description={article.data.description}
  typeOg="article"
  filAriane={[
    { nom: 'Le journal', lien: '/blog' },
    { nom: article.data.titre, lien: `/blog/${article.id}` },
  ]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(donnees)} />

  <article>
    <section class="tete">
      <span class="halo halo-anime tete-halo"></span>
      <div class="rail-etroit tete-contenu">
        <nav class="fil" aria-label="Fil d’Ariane">
          <a href="/">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Le journal</a>
        </nav>

        <span class="meta reveal">
          <span class="categorie">{article.data.categorie}</span>
          <span>{dateFr(article.data.date)}</span>
          <span>· {article.data.duree} de lecture</span>
        </span>

        <h1 class="reveal" style="--delai: 80ms">{article.data.titre}</h1>
        <p class="chapeau reveal" style="--delai: 160ms">{article.data.description}</p>

        <div class="signature reveal" style="--delai: 220ms">
          <img
            class="signature-photo"
            src="/images/julien-duplouy-112.webp"
            width="112"
            height="112"
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
          <span class="signature-texte">
            <strong>Julien Duplouy</strong>
            <em>Fondateur d’{site.nom}, développement de cabinet — {site.ville}</em>
          </span>
        </div>
      </div>
    </section>

    <section class="section-serree">
      <div class="rail-etroit">
        {
          sommaire.length > 2 && (
            <nav class="sommaire reveal" aria-label="Sommaire de l’article">
              <h2 class="sommaire-titre">Dans cet article</h2>
              <ul>
                {sommaire.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="prose corps reveal">
          <Content />
        </div>

        <aside class="encart-auteur reveal">
          <img
            class="auteur-photo"
            src="/images/julien-duplouy-112.webp"
            width="112"
            height="112"
            alt="Julien Duplouy"
            loading="lazy"
            decoding="async"
          />
          <div>
            <strong>Julien Duplouy</strong>
            <p>
              J’aide les thérapeutes, praticiens bien-être, professeurs de yoga et coachs à développer
              leur cabinet sans devenir experts en marketing, depuis {site.ville}, près de Tarbes. Un
              accompagnement de six mois, un tarif affiché — et un diagnostic gratuit pour commencer.
            </p>
            <a href="/diagnostic" class="lien-fleche">
              Faire le diagnostic des 5 fondations
              <Icone nom="fleche" classe="fleche" />
            </a>
          </div>
        </aside>
      </div>
    </section>

    {
      suggestions.length > 0 && (
        <section class="section-serree section-teintee">
          <div class="rail-etroit">
            <h2 class="suite-titre reveal">À lire ensuite</h2>
            <div class="suite">
              {suggestions.map((a, i) => (
                <a href={`/blog/${a.id}`} class="carte carte-relief suite-carte reveal" style={`--delai: ${i * 80}ms`}>
                  <span class="pastille">
                    <Icone nom={a.data.icone} />
                  </span>
                  <span class="meta">
                    <span class="categorie">{a.data.categorie}</span>
                    <span>{a.data.duree}</span>
                  </span>
                  <h3 class="suite-carte-titre">{a.data.titre}</h3>
                  <p>{a.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <BandeCta />
</Base>

<style>
  .tete {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(100% 70% at 85% 0%, rgba(230, 236, 247, 0.85), transparent 62%),
      var(--creme);
  }
  .tete-halo {
    width: 18rem; height: 18rem;
    top: -8rem; right: -6rem;
    background: rgba(217, 160, 106, 0.24);
  }
  .tete-contenu {
    position: relative;
    z-index: 1;
    padding-block: clamp(2rem, 6vw, 3.5rem) clamp(1.8rem, 5vw, 3rem);
  }

  .fil {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--encre-3);
    margin-bottom: 1.6rem;
  }
  .fil a { text-decoration: none; }
  .fil a:hover { color: var(--terre); }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.7rem;
    font-size: 0.8rem;
    color: var(--encre-3);
  }
  .categorie {
    padding: 0.22rem 0.65rem;
    border-radius: var(--r-pilule);
    background: var(--vert-clair);
    color: var(--vert);
    font-weight: 700;
  }
  .tete-contenu h1 { margin-top: 1.1rem; font-size: clamp(1.9rem, 5.6vw, 3rem); }
  .tete-contenu .chapeau { margin-top: 1.2rem; }

  .signature {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  .signature-photo {
    display: block;
    width: 2.7rem;
    height: 2.7rem;
    flex: none;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--vert-2), var(--vert));
    box-shadow: 0 0 0 2px var(--creme), 0 0 0 3px rgba(212, 178, 122, 0.5);
  }
  .signature-texte { display: grid; line-height: 1.35; }
  .signature-texte strong { font-size: 0.95rem; }
  .signature-texte em { font-style: normal; font-size: 0.85rem; color: var(--encre-3); }

  .sommaire {
    margin-bottom: 1.2rem;
    padding: clamp(1.1rem, 3vw, 1.5rem);
    border: 1px solid var(--ligne);
    border-radius: var(--r-xl);
    background: linear-gradient(160deg, #ffffff, var(--creme-2));
    box-shadow: var(--ombre-s);
  }
  .sommaire-titre {
    font-family: var(--police-texte);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vert);
  }
  .sommaire ul {
    margin: 0.9rem 0 0;
    padding-left: 1.05rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }
  .sommaire li::marker { color: var(--terre); }
  .sommaire a {
    color: var(--encre-2);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--transition), border-color var(--transition);
  }
  .sommaire a:hover { color: var(--terre); border-bottom-color: rgba(192, 102, 60, 0.4); }

  .corps {
    padding: clamp(1.4rem, 4vw, 2.4rem);
    background: var(--blanc);
    border: 1px solid var(--ligne);
    border-radius: var(--r-2xl);
    box-shadow: var(--ombre-m), var(--ombre-interne);
  }

  .encart-auteur {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
    margin-top: 1.5rem;
    padding: clamp(1.2rem, 3.4vw, 1.7rem);
    border-radius: var(--r-xl);
    border: 1px solid var(--ligne);
    background: linear-gradient(160deg, #FFFFFF, var(--creme-2));
    box-shadow: var(--ombre-s);
  }
  .auteur-photo {
    display: block;
    width: 3.2rem;
    height: 3.2rem;
    flex: none;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--vert-2), var(--vert));
    box-shadow: 0 0 0 2px var(--creme), 0 0 0 3px rgba(212, 178, 122, 0.5);
  }
  .encart-auteur p { margin-block: 0.4rem 0.9rem; font-size: 0.94rem; color: var(--encre-2); }

  .suite-titre { font-size: clamp(1.3rem, 3.4vw, 1.7rem); margin-bottom: 1.2rem; }
  .suite { display: grid; gap: 1.15rem; }
  .suite-carte { text-decoration: none; }
  .suite-carte .meta { margin-block: 0.2rem 0.6rem; }
  .suite-carte-titre { font-size: 1.1rem; margin-bottom: 0.5rem; }
  @media (min-width: 760px) {
    .suite { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
