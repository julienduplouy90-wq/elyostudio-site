---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import Icone from '../components/Icone.astro';
import BandeCta from '../components/BandeCta.astro';
import { site } from '../data/site.js';

const titre = 'Julien Duplouy, fondateur d’ElyoStudio';
const description =
  'Studio indépendant fondé par Julien Duplouy, à Aureilhan près de Tarbes. Une seule spécialité : les sites internet de naturopathes.';

const valeurs = [
  {
    icone: 'etiquette',
    titre: 'Dire le prix avant',
    texte:
      'Le tarif est affiché sur le site. Vous savez ce que vous payez avant de m’écrire, et il ne change pas selon la tête du client.',
  },
  {
    icone: 'personnes',
    titre: 'Parler simplement',
    texte:
      'Pas de jargon, pas de tableau de bord illisible. Je vous explique ce que je fais et pourquoi, en français courant.',
  },
  {
    icone: 'bouclier',
    titre: 'Ne pas promettre l’impossible',
    texte:
      'Personne ne peut garantir la première place sur Google. Je préfère annoncer un dispositif honnête plutôt qu’un miracle.',
  },
  {
    icone: 'cadenas',
    titre: 'Ne rien garder en otage',
    texte:
      'Domaine, contenus, accès : tout est à votre nom. Si un jour vous partez, vous partez avec votre site.',
  },
];
---

<Base titre={titre} description={description} filAriane={[{ nom: "À propos", lien: "/a-propos" }]}>
  <EnPage
    surtitre="À propos"
    titre="Un studio, une spécialité, un interlocuteur"
    chapeau="ElyoStudio, c’est moi, Julien Duplouy. Je travaille depuis Aureilhan, à côté de Tarbes, avec des naturopathes partout en France. Je ne fais que ça, et c’est justement l’intérêt."
  />

  <section class="section-serree">
    <div class="rail portrait-rail">
      <div class="portrait-carte reveal">
        <div class="portrait-visuel">
          <img
            class="portrait-photo"
            src="/images/julien-duplouy-220.webp"
            srcset="/images/julien-duplouy-220.webp 220w, /images/julien-duplouy-440.webp 440w"
            sizes="(min-width: 900px) 200px, 45vw"
            width="220"
            height="220"
            alt="Julien Duplouy, fondateur d’ElyoStudio"
            fetchpriority="high"
          />
          <span class="portrait-anneau" aria-hidden="true"></span>
          <span class="portrait-pastille portrait-pastille-terre" aria-hidden="true"></span>
          <span class="portrait-pastille portrait-pastille-vert" aria-hidden="true"></span>
        </div>
        <div class="portrait-infos">
          <h2 class="portrait-nom">Julien Duplouy</h2>
          <p class="portrait-role">Fondateur d’{site.nom}</p>
          <ul class="portrait-liste">
            <li><Icone nom="position" /> {site.ville}, {site.region}</li>
            <li><Icone nom="video" /> À distance, partout en France</li>
            <li><Icone nom="courrier" /> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>
      </div>

      <div class="portrait-texte prose reveal" style="--delai: 90ms">
        <h2>De la communication à la création de sites</h2>
        <p>
          J’ai passé plusieurs années dans la communication et le marketing digital, à travailler pour
          des structures de tailles très différentes. J’y ai vu la même scène se répéter : des
          indépendants sérieux, compétents, appréciés de leurs clients… et parfaitement invisibles dès
          qu’on ouvre Google.
        </p>
        <p>
          Les sites qu’on leur vendait coûtaient cher, arrivaient tard et se transformaient en jolie
          plaquette figée. Aucun ne parlait vraiment de rendez-vous. J’ai créé <strong>{site.nom}</strong>
          pour faire l’inverse : un dispositif complet, un prix affiché, un délai tenu.
        </p>

        <h2>Pourquoi seulement les naturopathes</h2>
        <p>
          Parce qu’à force de travailler avec la même profession, on connaît ses questions par cœur :
          comment présenter une première consultation, comment parler d’une approche sans tomber sous
          le coup des règles sur les allégations de santé, quelles pages Google attend réellement pour
          une recherche locale.
        </p>
        <p>
          Ce que j’apprends chez une praticienne profite aux suivantes. Vous n’achetez pas seulement
          des pages : vous achetez une structure déjà éprouvée sur votre métier.
        </p>

        <h2>Ce que ça change pour vous</h2>
        <p>
          Vous n’avez qu’un seul interlocuteur : celui qui répond à vos emails est aussi celui qui
          écrit les textes, dessine les pages et surveille le site. Pas de chef de projet à qui il faut
          tout réexpliquer, pas de délai qui glisse parce que le prestataire attend un autre service.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-teintee">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Ma façon de travailler</span>
        <h2>Quatre principes, tenus sur chaque projet</h2>
      </div>
      <div class="grille grille-4 marge-haut-grand">
        {
          valeurs.map((v, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 80}ms`}>
              <span class="pastille"><Icone nom={v.icone} /></span>
              <h3>{v.titre}</h3>
              <p>{v.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <BandeCta
    titre="Faisons connaissance, sans engagement"
    texte="Trente minutes en visio suffisent pour savoir si l’on peut travailler ensemble. Et si ce n’est pas le cas, je vous le dirai."
    bouton="Réserver un appel de 30 minutes"
    lien="/rendez-vous"
  />
</Base>

<style>
  .marge-haut-grand { margin-top: clamp(2rem, 5vw, 3rem); }

  .portrait-rail { display: grid; gap: clamp(1.5rem, 5vw, 2.5rem); align-items: start; }

  .portrait-carte {
    position: relative;
    overflow: hidden;
    padding: clamp(1.4rem, 4vw, 1.9rem);
    border-radius: var(--r-xl);
    border: 1px solid var(--ligne);
    background: linear-gradient(165deg, #FFFFFF, var(--creme-2));
    box-shadow: var(--ombre-m), var(--ombre-interne);
  }
  /* Le portrait est livré déjà détouré en rond ; le cadre, lui, est dessiné
     ici avec les jetons de la charte, donc net à toutes les tailles. */
  .portrait-visuel {
    position: relative;
    width: min(12.5rem, 62%);
    margin-inline: auto;
    aspect-ratio: 1;
  }
  .portrait-photo {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--vert-clair), #C7DCCF);
    box-shadow: var(--ombre-m);
  }
  .portrait-anneau {
    position: absolute;
    inset: -0.6rem;
    border-radius: 50%;
    border: 2px solid var(--or);
    opacity: 0.55;
  }
  .portrait-pastille {
    position: absolute;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    border: 2px solid var(--creme);
  }
  .portrait-pastille-terre { background: var(--terre); right: 0.15rem; bottom: 1.1rem; }
  .portrait-pastille-vert { background: var(--vert); left: -0.7rem; top: 3rem; }
  .portrait-nom { margin-top: 1.3rem; font-size: 1.4rem; }
  .portrait-role { color: var(--terre); font-weight: 600; font-size: 0.95rem; }
  .portrait-liste { list-style: none; padding: 0; margin-top: 1.2rem; display: grid; gap: 0.65rem; }
  .portrait-liste li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
    color: var(--encre-2);
  }
  .portrait-liste :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--vert); flex: none; }
  .portrait-liste a { text-decoration: none; }
  .portrait-liste a:hover { color: var(--terre); }

  .portrait-texte h2:first-child { margin-top: 0; }

  @media (min-width: 900px) {
    .portrait-rail { grid-template-columns: 0.8fr 1.2fr; gap: 3rem; }
    .portrait-carte { position: sticky; top: 6.5rem; }
  }
</style>
