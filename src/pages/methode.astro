---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import Icone from '../components/Icone.astro';
import BandeCta from '../components/BandeCta.astro';
import { lienDemarrer } from '../data/site.js';

const titre = 'La méthode : six mois, quatre phases | ElyoStudio';
const description =
  'Démarrage, rendez-vous de lancement, mise en place du système, puis six mois d’accompagnement à la demande. Sans jargon, sans réunion inutile.';

const detail = [
  {
    n: '01',
    titre: 'Vous démarrez',
    duree: 'Jour 0',
    icone: 'etiquette',
    texte:
      'En ligne, directement — ou après un échange découverte si vous préférez en parler d’abord. Vous recevez un questionnaire d’accueil guidé : votre pratique, vos patients, vos offres, vos outils.',
    points: ['Pas d’appel commercial obligatoire', 'Une heure de questionnaire, en plusieurs fois si besoin', 'Un créneau pour le rendez-vous de lancement'],
  },
  {
    n: '02',
    titre: 'Le rendez-vous de lancement',
    duree: 'Semaine 1',
    icone: 'video',
    texte:
      'Une visio pour poser le diagnostic de votre cabinet : d’où viennent vos rendez-vous, ce qui freine, votre positionnement, vos offres et vos tarifs. Vous en sortez avec le plan des six mois, que je vous remets par écrit.',
    points: ['Diagnostic de l’activité', 'Positionnement et offres clarifiés', 'Une feuille de route écrite, que vous gardez'],
  },
  {
    n: '03',
    titre: 'La mise en place du système',
    duree: 'Semaines 2 à 6',
    icone: 'gabarit',
    texte:
      'Je construis, vous validez : site créé ou optimisé, prise de rendez-vous en ligne, fiche Google Business Profile, bases du référencement local, stratégie de contenu. Les premières semaines sont les plus denses.',
    points: ['Textes rédigés avec vous, dans vos mots', 'Réservation testée de bout en bout, mobile compris', 'Fiche Google complète et active'],
  },
  {
    n: '04',
    titre: 'Six mois avec Elyo Direct',
    duree: 'Mois 1 à 6',
    icone: 'bouclier',
    texte:
      'Acquisition mise en route, publicité locale si pertinente, suivi des résultats, optimisation continue. Et dès le premier jour : une question, un blocage, une publication à valider — vous me sollicitez, je réponds par le canal le plus efficace.',
    points: ['Message, vocal, petite vidéo, document, visio quand c’est utile', 'Sans compteur, pendant toute la durée', 'Ce qui amène des rendez-vous est renforcé, le reste est coupé'],
  },
];

const cotéVous = [
  'Le questionnaire d’accueil, puis vos validations',
  'Vos photos, ou un créneau pour en faire de bonnes',
  'Quelques heures par semaine au début, beaucoup moins ensuite',
  'Dire quand ça bloque — c’est tout l’intérêt d’Elyo Direct',
];

const cotéMoi = [
  'Le diagnostic, le positionnement, les offres et les tarifs',
  'Le site, la prise de rendez-vous, la fiche Google, le référencement local',
  'Le plan d’acquisition, le suivi des résultats, les ajustements',
  'Les réponses, les retours et les décisions, tout au long des six mois',
];
---

<Base titre={titre} description={description} filAriane={[{ nom: "La méthode", lien: "/methode" }]}>
  <EnPage
    surtitre="La méthode"
    titre="Six mois, quatre phases, et quelqu’un à vos côtés"
    chapeau="Vous n’avez pas à comprendre l’hébergement, le référencement ou les campagnes. Je pose le diagnostic, je construis, vous validez — et vous restez acteur de votre développement, guidé à chaque étape."
  >
    <div class="groupe-btn marge-haut">
      <a href={lienDemarrer} class="btn btn-principal btn-large">
        Démarrer — 990 €
        <Icone nom="fleche" classe="fleche" />
      </a>
      <a href="/offre" class="btn btn-secondaire btn-large">Voir l’accompagnement en détail</a>
    </div>
  </EnPage>

  <section class="section">
    <div class="rail">
      <ol class="chrono">
        {
          detail.map((e, i) => (
            <li class="chrono-item reveal" style={`--delai: ${i * 80}ms`}>
              <div class="chrono-marqueur">
                <span class="chrono-pastille"><Icone nom={e.icone} /></span>
              </div>
              <article class="chrono-carte">
                <div class="chrono-entete">
                  <span class="chrono-numero">{e.n}</span>
                  <span class="chrono-duree">{e.duree}</span>
                </div>
                <h2 class="chrono-titre">{e.titre}</h2>
                <p class="chrono-texte">{e.texte}</p>
                <ul class="liste-cochee chrono-liste">
                  {e.points.map((p) => <li>{p}</li>)}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-teintee">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Qui fait quoi</span>
        <h2>Qui fait quoi pendant les six mois</h2>
      </div>

      <div class="deux-colonnes marge-haut-grand">
        <div class="carte reveal">
          <span class="pastille"><Icone nom="personnes" /></span>
          <h3>De votre côté</h3>
          <ul class="liste-cochee marge-haut-petit">
            {cotéVous.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="carte reveal" style="--delai: 100ms">
          <span class="pastille pastille-terre"><Icone nom="outil" /></span>
          <h3>De mon côté</h3>
          <ul class="liste-cochee marge-haut-petit">
            {cotéMoi.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <BandeCta
    titre="Le premier pas ne coûte rien"
    texte="Faites le diagnostic des 5 fondations : quinze questions, sept minutes, votre score et vos trois priorités. Vous saurez précisément où vous en êtes avant même qu’on se parle."
  />
</Base>

<style>
  .marge-haut { margin-top: 1.8rem; }
  .marge-haut-petit { margin-top: 1rem; }
  .marge-haut-grand { margin-top: clamp(2rem, 5vw, 3rem); }

  .chrono { list-style: none; padding: 0; display: grid; gap: 1.2rem; }
  .chrono-item { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1rem; }

  .chrono-marqueur { position: relative; display: flex; justify-content: center; }
  .chrono-marqueur::after {
    content: '';
    position: absolute;
    top: 3.4rem;
    bottom: -1.6rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, rgba(28, 46, 87, 0.3), rgba(28, 46, 87, 0.05));
  }
  .chrono-item:last-child .chrono-marqueur::after { display: none; }

  .chrono-pastille {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-m);
    background: linear-gradient(150deg, var(--vert-2), var(--vert));
    color: #F4F6FA;
    box-shadow: 0 12px 24px -16px rgba(28, 46, 87, 0.95);
  }
  .chrono-pastille :global(svg) { width: 1.4rem; height: 1.4rem; }

  .chrono-carte {
    padding: clamp(1.2rem, 3.6vw, 1.8rem);
    background: var(--blanc);
    border: 1px solid var(--ligne);
    border-radius: var(--r-xl);
    box-shadow: var(--ombre-s), var(--ombre-interne);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .chrono-carte:hover { transform: translateY(-3px); box-shadow: var(--ombre-m); }

  .chrono-entete { display: flex; align-items: center; gap: 0.8rem; }
  .chrono-numero {
    font-family: var(--police-titre);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--terre);
  }
  .chrono-duree {
    padding: 0.2rem 0.65rem;
    border-radius: var(--r-pilule);
    background: var(--creme-2);
    border: 1px solid var(--ligne);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--encre-3);
  }
  .chrono-titre { margin-top: 0.7rem; font-size: clamp(1.2rem, 3vw, 1.5rem); }
  .chrono-texte { margin-top: 0.7rem; color: var(--encre-2); font-size: 0.99rem; }
  .chrono-liste { margin-top: 1.1rem; }

  .deux-colonnes { display: grid; gap: 1.15rem; }
  @media (min-width: 800px) {
    .deux-colonnes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
