---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import Icone from '../components/Icone.astro';
import BandeCta from '../components/BandeCta.astro';

const titre = 'La méthode : 21 jours de socle, un an de filet | ElyoStudio';
const description =
  'Bilan de 30 minutes, trois semaines pour poser le socle — positionnement, offre, site, visibilité — puis douze mois de filet. Sans jargon, sans réunion inutile.';

const detail = [
  {
    n: '01',
    titre: 'Le bilan de 30 minutes',
    duree: 'Jour 0',
    icone: 'video',
    texte:
      'On fait le point sur votre situation : où vous en êtes, ce qui freine, ce que vous voulez construire. Vous repartez avec des priorités claires — et je vous dis franchement si je peux vous aider.',
    points: ['En visio, à l’heure qui vous arrange', 'Offert, sans engagement', 'Encore mieux si vous avez fait le diagnostic avant'],
  },
  {
    n: '02',
    titre: 'Semaine 1 : positionnement, offre et tarifs',
    duree: 'Jours 1 à 7',
    icone: 'recherche',
    texte:
      'Qui vous aidez, sur quoi, comment, à quel prix. Deux séances de travail et un questionnaire guidé : à la fin de la semaine, votre positionnement tient en une phrase et vos offres en une page.',
    points: ['Deux séances de travail en visio', 'Votre offre d’entrée structurée, tarifs posés', 'La base de tous les textes du site'],
  },
  {
    n: '03',
    titre: 'Semaines 2 et 3 : site, fiche Google, rendez-vous',
    duree: 'Jours 8 à 21',
    icone: 'gabarit',
    texte:
      'Je construis le site autour du positionnement posé, j’installe la prise de rendez-vous en ligne, je crée ou remets à plat votre fiche Google. Vous validez tout en vidéo ; rien ne part en ligne sans votre feu vert.',
    points: ['Textes rédigés à partir de nos échanges', 'Réservation testée de bout en bout, mobile compris', 'En ligne au jour 21, fiche Google active'],
  },
  {
    n: '04',
    titre: 'Douze mois de Filet',
    duree: 'Mois 1 à 12',
    icone: 'bouclier',
    texte:
      'Un entretien de 90 minutes pose votre plan d’action écrit. Ensuite, chaque fois que vous bloquez : une séance de 20 minutes sous 72 h ouvrées, une décision claire, un compte rendu. Et un bilan à 6 mois, puis à 12.',
    points: ['À la demande, sans programme imposé', 'Un sujet précis par séance', 'Un compte rendu écrit après chacune'],
  },
];

const cotéVous = [
  'Deux séances de travail la première semaine, puis vos validations',
  'Une heure pour le questionnaire de départ',
  'Vos photos, ou un créneau pour en faire de bonnes',
  'Dire quand ça bloque — c’est le principe du Filet',
];

const cotéMoi = [
  'Le cadrage du positionnement, de l’offre et des tarifs',
  'La conception, la rédaction et l’intégration du site',
  'Le nom de domaine, l’hébergement, la fiche Google, la prise de rendez-vous',
  'Les séances de déblocage, les comptes rendus et les bilans',
];
---

<Base titre={titre} description={description} filAriane={[{ nom: "La méthode", lien: "/methode" }]}>
  <EnPage
    surtitre="La méthode"
    titre="Trois semaines pour le socle, douze mois de filet"
    chapeau="Vous n’avez pas à comprendre l’hébergement, le DNS ou le référencement. On clarifie, je construis, vous validez — puis je reste à portée de visio pendant un an."
  >
    <div class="groupe-btn marge-haut">
      <a href="/rendez-vous" class="btn btn-principal btn-large">
        Réserver mon bilan de lancement
        <Icone nom="fleche" classe="fleche" />
      </a>
      <a href="/offre" class="btn btn-secondaire btn-large">Voir l’accompagnement et le tarif</a>
    </div>
  </EnPage>

  <section class="section">
    <div class="rail">
      <ol class="chrono">
        {
          detail.map((e, i) => (
            <li class="chrono-item reveal" style={`--delai: ${i * 80}ms`}>
              <div class="chrono-marqueur">
                <span class="chrono-pastille"><Icone nom={e.icone} /></span>
              </div>
              <article class="chrono-carte">
                <div class="chrono-entete">
                  <span class="chrono-numero">{e.n}</span>
                  <span class="chrono-duree">{e.duree}</span>
                </div>
                <h2 class="chrono-titre">{e.titre}</h2>
                <p class="chrono-texte">{e.texte}</p>
                <ul class="liste-cochee chrono-liste">
                  {e.points.map((p) => <li>{p}</li>)}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-teintee">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Qui fait quoi</span>
        <h2>Votre part du travail reste tenable, même en activité</h2>
      </div>

      <div class="deux-colonnes marge-haut-grand">
        <div class="carte reveal">
          <span class="pastille"><Icone nom="personnes" /></span>
          <h3>De votre côté</h3>
          <ul class="liste-cochee marge-haut-petit">
            {cotéVous.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="carte reveal" style="--delai: 100ms">
          <span class="pastille pastille-terre"><Icone nom="outil" /></span>
          <h3>De mon côté</h3>
          <ul class="liste-cochee marge-haut-petit">
            {cotéMoi.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <BandeCta
    titre="Le premier pas ne coûte rien"
    texte="Faites le diagnostic des 5 fondations : quinze questions, sept minutes, votre score et vos trois priorités. Vous saurez précisément où vous en êtes avant même qu’on se parle."
  />
</Base>

<style>
  .marge-haut { margin-top: 1.8rem; }
  .marge-haut-petit { margin-top: 1rem; }
  .marge-haut-grand { margin-top: clamp(2rem, 5vw, 3rem); }

  .chrono { list-style: none; padding: 0; display: grid; gap: 1.2rem; }
  .chrono-item { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1rem; }

  .chrono-marqueur { position: relative; display: flex; justify-content: center; }
  .chrono-marqueur::after {
    content: '';
    position: absolute;
    top: 3.4rem;
    bottom: -1.6rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, rgba(46, 90, 75, 0.3), rgba(46, 90, 75, 0.05));
  }
  .chrono-item:last-child .chrono-marqueur::after { display: none; }

  .chrono-pastille {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-m);
    background: linear-gradient(150deg, var(--vert-2), var(--vert));
    color: #F2F7F3;
    box-shadow: 0 12px 24px -16px rgba(46, 90, 75, 0.95);
  }
  .chrono-pastille :global(svg) { width: 1.4rem; height: 1.4rem; }

  .chrono-carte {
    padding: clamp(1.2rem, 3.6vw, 1.8rem);
    background: var(--blanc);
    border: 1px solid var(--ligne);
    border-radius: var(--r-xl);
    box-shadow: var(--ombre-s), var(--ombre-interne);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .chrono-carte:hover { transform: translateY(-3px); box-shadow: var(--ombre-m); }

  .chrono-entete { display: flex; align-items: center; gap: 0.8rem; }
  .chrono-numero {
    font-family: var(--police-titre);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--terre);
  }
  .chrono-duree {
    padding: 0.2rem 0.65rem;
    border-radius: var(--r-pilule);
    background: var(--creme-2);
    border: 1px solid var(--ligne);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--encre-3);
  }
  .chrono-titre { margin-top: 0.7rem; font-size: clamp(1.2rem, 3vw, 1.5rem); }
  .chrono-texte { margin-top: 0.7rem; color: var(--encre-2); font-size: 0.99rem; }
  .chrono-liste { margin-top: 1.1rem; }

  .deux-colonnes { display: grid; gap: 1.15rem; }
  @media (min-width: 800px) {
    .deux-colonnes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
