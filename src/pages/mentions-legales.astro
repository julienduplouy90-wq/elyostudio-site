---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import { site } from '../data/site.js';

const titre = 'Mentions légales | ElyoStudio';
const description = `Mentions légales du site ${site.domaine}, édité par ${site.entreprise.raison}, SIREN ${site.entreprise.siren}, à ${site.ville} dans les ${site.region}.`;
---

<Base titre={titre} description={description} barreMobile={false}>
  <EnPage surtitre="Informations légales" titre="Mentions légales" etroit />

  <section class="section-serree">
    <div class="rail-etroit prose reveal">
      <h2>Éditeur du site</h2>
      <p>
        Le site {site.domaine} est édité par {site.entreprise.raison}, entrepreneur individuel sous le
        régime de la micro-entreprise, SIREN {site.entreprise.siren}, {site.adresse}, France.
        Email : <a href={`mailto:${site.email}`}>{site.email}</a> — Téléphone :
        <a href={`tel:${site.telephoneLien}`}>{site.telephone}</a>.
      </p>
      <p>
        Activité : {site.entreprise.activite}. {site.entreprise.tva}.
      </p>

      <h2>Directeur de la publication</h2>
      <p>Julien Duplouy.</p>

      <h2>Hébergement</h2>
      <p>
        Le site est hébergé par GitHub, Inc., 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107,
        États-Unis (service GitHub Pages).
      </p>
      <p class="note">
        À adapter si le site est déployé ailleurs — par exemple Hostinger International Limited,
        61 Lordou Vironos Street, 6023 Larnaca, Chypre.
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        L’ensemble des éléments du site (textes, graphismes, logo, mise en page, code) est protégé par
        le droit de la propriété intellectuelle. Toute reproduction, représentation ou diffusion,
        totale ou partielle, sans autorisation écrite préalable, est interdite.
      </p>

      <h2>Responsabilité</h2>
      <p>
        Les informations diffusées sur ce site sont présentées à titre indicatif. {site.nom} ne saurait
        être tenu responsable d’éventuelles erreurs, omissions ou indisponibilités. Les résultats de
        visibilité en ligne dépendent de nombreux facteurs externes et ne peuvent faire l’objet d’une
        garantie.
      </p>

      <h2>Liens externes</h2>
      <p>
        Ce site peut renvoyer vers des sites tiers (agenda de réservation, outils partenaires).
        {site.nom} n’exerce aucun contrôle sur leur contenu et décline toute responsabilité à leur
        égard.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Le traitement de vos données est décrit dans la
        <a href="/confidentialite">politique de confidentialité</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .note {
    padding: 0.9rem 1.1rem;
    border-radius: var(--r-m);
    background: var(--creme-2);
    border: 1px solid var(--ligne);
    font-size: 0.9rem;
  }
</style>
