---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import Icone from '../components/Icone.astro';
import { site, prix, lienDemarrer } from '../data/site.js';

const titre = 'Échange découverte : un appel court, offert | ElyoStudio';
const description =
  'Vingt minutes en visio pour faire le point sur votre cabinet et vérifier qu’Elyo Croissance vous correspond. Offert, sans engagement.';

const obtenez = [
  'Une lecture extérieure et honnête de votre situation',
  'Deux ou trois priorités concrètes, à garder même si nous ne travaillons pas ensemble',
  'Une réponse franche : Elyo Croissance vous correspond, ou non',
  'Aucun engagement, aucune relance insistante ensuite',
];
---

<Base titre={titre} description={description} barreMobile={false} filAriane={[{ nom: "Échange découverte", lien: "/rendez-vous" }]}>
  <EnPage
    surtitre="Échange découverte — offert"
    titre="Besoin d’en parler avant de démarrer ? Prenons un appel court."
    chapeau="Vingt minutes en visio pour poser votre situation à plat : où en est votre cabinet, ce qui freine, et si Elyo Croissance est le bon choix pour vous. Ce n’est pas une séance de coaching — c’est une vérification, dans les deux sens."
  />

  <section class="section-serree">
    <div class="rail rdv-rail">
      <div class="agenda carte reveal" data-agenda data-src={site.agenda}>
        <div class="agenda-attente">
          <p class="agenda-attente-texte">
            L’agenda de réservation est fourni par TidyCal, qui dépose ses propres cookies
            techniques au chargement. Il ne s’affiche qu’avec votre accord.
          </p>
          <button type="button" class="btn btn-principal" data-agenda-charger>Afficher l’agenda</button>
          <a href={site.agenda} target="_blank" rel="noopener" class="lien-fleche">
            Ou réserver dans un nouvel onglet
            <Icone nom="fleche" classe="fleche" />
          </a>
        </div>
        <p class="agenda-secours" hidden>
          L’agenda ne s’affiche pas ?
          <a href={site.agenda} target="_blank" rel="noopener" class="lien-fleche">
            Ouvrir la page de réservation
            <Icone nom="fleche" classe="fleche" />
          </a>
        </p>
      </div>

      <aside class="rdv-aside">
        <div class="carte carte-douce reveal">
          <span class="pastille"><Icone nom="video" /></span>
          <h2 class="aside-titre">Ce que vous en retirez</h2>
          <ul class="liste-cochee marge-haut-petit">
            {obtenez.map((p) => <li>{p}</li>)}
          </ul>
        </div>

        <div class="carte reveal" style="--delai: 90ms">
          <h2 class="aside-titre">Déjà décidé ?</h2>
          <p class="texte-doux aside-texte">
            L’appel n’est pas obligatoire. Si vous êtes prêt, vous démarrez directement :
            {prix.activation} d’activation, puis {prix.mensuel} par mois, sans engagement.
          </p>
          <a href={lienDemarrer} class="btn btn-principal btn-large">
            Démarrer Elyo Croissance
            <Icone nom="fleche" classe="fleche" />
          </a>
        </div>

        <div class="carte reveal" style="--delai: 160ms">
          <h2 class="aside-titre">Pas encore prêt à en parler ?</h2>
          <p class="texte-doux aside-texte">
            Commencez par le diagnostic des 5 fondations : quinze questions, sept minutes, et vous
            arrivez à l’appel avec vos résultats en main.
          </p>
          <a href="/diagnostic" class="lien-fleche">
            Faire le diagnostic gratuit
            <Icone nom="fleche" classe="fleche" />
          </a>
        </div>
      </aside>
    </div>
  </section>
</Base>


<script>
  // L'agenda TidyCal n'est chargé qu'après consentement (bandeau cookies, ou
  // clic explicite ici). L'iframe est créée en JS : ses styles sont globaux.
  const bloc = document.querySelector<HTMLElement>('[data-agenda]');
  const charger = () => {
    if (!bloc || bloc.querySelector('iframe')) return;
    const cadre = document.createElement('iframe');
    cadre.src = bloc.dataset.src ?? '';
    cadre.title = 'Agenda de réservation ElyoStudio';
    cadre.loading = 'lazy';
    cadre.referrerPolicy = 'no-referrer-when-downgrade';
    bloc.querySelector('.agenda-attente')?.remove();
    bloc.prepend(cadre);
    bloc.querySelector('.agenda-secours')?.removeAttribute('hidden');
  };

  if (localStorage.getItem('elyo-cookies') === 'oui') charger();
  document.addEventListener('elyo-cookies', (e) => {
    if ((e as CustomEvent).detail === 'oui') charger();
  });
  bloc?.querySelector('[data-agenda-charger]')?.addEventListener('click', () => {
    localStorage.setItem('elyo-cookies', 'oui');
    const bandeau = document.querySelector<HTMLElement>('[data-cookies]');
    if (bandeau) bandeau.hidden = true;
    charger();
  });
</script>

<style>
  .marge-haut-petit { margin-top: 1rem; }

  .rdv-rail { display: grid; gap: 1.4rem; align-items: start; }
  .rdv-aside { display: grid; gap: 1.15rem; }
  .aside-titre { font-size: 1.2rem; }
  .aside-texte { margin-block: 0.7rem 1.2rem; font-size: 0.95rem; }

  .agenda { padding: 0.75rem; border-radius: var(--r-xl); overflow: hidden; }
  .agenda-attente {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    min-height: 24rem;
    align-content: center;
    padding: clamp(1.2rem, 4vw, 2.2rem);
    border-radius: var(--r-l);
    background: var(--creme-2);
  }
  .agenda-attente-texte { max-width: 30rem; color: var(--encre-2); }
  .agenda-secours {
    padding: 0.9rem 0.6rem 0.3rem;
    font-size: 0.88rem;
    color: var(--encre-2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  @media (min-width: 1000px) {
    .rdv-rail { grid-template-columns: 1.5fr 0.85fr; gap: 1.8rem; }
  }
</style>

<style is:global>
  .agenda iframe {
    width: 100%;
    height: min(78vh, 46rem);
    min-height: 34rem;
    border: 0;
    border-radius: var(--r-l);
    background: var(--creme-2);
  }
</style>
