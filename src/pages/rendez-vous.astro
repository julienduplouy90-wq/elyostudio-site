---
import Base from '../layouts/Base.astro';
import EnPage from '../components/EnPage.astro';
import Icone from '../components/Icone.astro';
import { site, prix, lienDemarrer } from '../data/site.js';

const titre = 'Échange découverte : un appel court, offert | ElyoStudio';
const description =
  'Vingt minutes en visio pour faire le point sur votre cabinet et vérifier qu’Elyo Direct vous correspond. Offert, sans engagement.';

const obtenez = [
  'Une lecture extérieure et honnête de votre situation',
  'Deux ou trois priorités concrètes, à garder même si nous ne travaillons pas ensemble',
  'Une réponse franche : Elyo Direct vous correspond, ou non',
  'Aucun engagement, aucune relance insistante ensuite',
];
---

<Base titre={titre} description={description} barreMobile={false} filAriane={[{ nom: "Échange découverte", lien: "/rendez-vous" }]}>
  <EnPage
    surtitre="Échange découverte — offert"
    titre="Besoin d’en parler avant de démarrer ? Prenons un appel court."
    chapeau="Vingt minutes en visio pour poser votre situation à plat : où en est votre cabinet, ce qui freine, et si Elyo Direct est le bon choix pour vous. Ce n’est pas une séance de coaching — c’est une vérification, dans les deux sens."
  />

  <section class="section-serree">
    <div class="rail rdv-rail">
      <div class="agenda carte reveal">
        <iframe
          src={site.agenda}
          title="Agenda de réservation ElyoStudio"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <p class="agenda-secours">
          L’agenda ne s’affiche pas ?
          <a href={site.agenda} target="_blank" rel="noopener" class="lien-fleche">
            Ouvrir la page de réservation
            <Icone nom="fleche" classe="fleche" />
          </a>
        </p>
      </div>

      <aside class="rdv-aside">
        <div class="carte carte-douce reveal">
          <span class="pastille"><Icone nom="video" /></span>
          <h2 class="aside-titre">Ce que vous en retirez</h2>
          <ul class="liste-cochee marge-haut-petit">
            {obtenez.map((p) => <li>{p}</li>)}
          </ul>
        </div>

        <div class="carte reveal" style="--delai: 90ms">
          <h2 class="aside-titre">Déjà décidé ?</h2>
          <p class="texte-doux aside-texte">
            L’appel n’est pas obligatoire. Si vous êtes prêt, vous démarrez directement :
            {prix.total} pour {prix.duree}, ou {prix.paiement3x} sans frais.
          </p>
          <a href={lienDemarrer} class="btn btn-principal btn-large">
            Démarrer Elyo Direct
            <Icone nom="fleche" classe="fleche" />
          </a>
        </div>

        <div class="carte reveal" style="--delai: 160ms">
          <h2 class="aside-titre">Pas encore prêt à en parler ?</h2>
          <p class="texte-doux aside-texte">
            Commencez par le diagnostic des 5 fondations : quinze questions, sept minutes, et vous
            arrivez à l’appel avec vos résultats en main.
          </p>
          <a href="/diagnostic" class="lien-fleche">
            Faire le diagnostic gratuit
            <Icone nom="fleche" classe="fleche" />
          </a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .marge-haut-petit { margin-top: 1rem; }

  .rdv-rail { display: grid; gap: 1.4rem; align-items: start; }
  .rdv-aside { display: grid; gap: 1.15rem; }
  .aside-titre { font-size: 1.2rem; }
  .aside-texte { margin-block: 0.7rem 1.2rem; font-size: 0.95rem; }

  .agenda { padding: 0.75rem; border-radius: var(--r-xl); overflow: hidden; }
  .agenda iframe {
    width: 100%;
    height: min(78vh, 46rem);
    min-height: 34rem;
    border: 0;
    border-radius: var(--r-l);
    background: var(--creme-2);
  }
  .agenda-secours {
    padding: 0.9rem 0.6rem 0.3rem;
    font-size: 0.88rem;
    color: var(--encre-2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  @media (min-width: 1000px) {
    .rdv-rail { grid-template-columns: 1.5fr 0.85fr; gap: 1.8rem; }
  }
</style>
