---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Maquette from '../components/Maquette.astro';
import BandeCta from '../components/BandeCta.astro';
import Comparatif from '../components/Comparatif.astro';
import {
  site,
  prix,
  problemes,
  solutions,
  etapes,
  socle,
  filet,
  nonPromis,
  engagements,
  faqs,
} from '../data/site.js';

const titre = 'Studio de lancement pour thérapeutes | ElyoStudio';
const description = `Positionnement, offre, site, visibilité locale : le socle en ${prix.delai}, puis un an d’accompagnement à la demande. ${prix.total}, tout compris.`;

const donnees = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${site.url}/#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Service',
      '@id': `${site.url}/#terre-ferme`,
      name: 'Terre Ferme — lancement et accompagnement pour thérapeutes',
      serviceType: 'Positionnement, création de site internet, visibilité locale et accompagnement',
      provider: { '@id': `${site.url}/#studio` },
      areaServed: { '@type': 'Country', name: 'France' },
      audience: {
        '@type': 'Audience',
        audienceType: 'Thérapeutes et professionnels indépendants de l’accompagnement',
      },
      offers: {
        '@type': 'Offer',
        price: '1998',
        priceCurrency: 'EUR',
        description: `${prix.total} comptant, ou ${prix.paiement3x} sans frais. Socle livré en ${prix.delai}, accompagnement pendant ${prix.duree}.`,
        url: `${site.url}/offre`,
        availability: 'https://schema.org/InStock',
      },
    },
  ],
};
---

<Base titre={titre} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(donnees)} />

  <!-- ===== HÉROS ===== -->
  <section class="heros">
    <span class="halo halo-anime heros-halo-1"></span>
    <span class="halo halo-anime-2 heros-halo-2"></span>

    <div class="rail heros-rail">
      <div class="heros-texte">
        <span class="etiquette reveal">
          <span class="point"></span>
          Studio de lancement — thérapeutes &amp; accompagnants
        </span>

        <h1 class="reveal" style="--delai: 90ms">
          Le socle de votre activité en 21 jours.
          <span class="souligne">Puis un filet pendant un an.</span>
        </h1>

        <p class="chapeau reveal" style="--delai: 180ms">
          Positionnement, offre, tarifs, site professionnel, visibilité locale : en trois semaines,
          on pose ensemble des fondations solides. Ensuite, chaque fois que vous bloquez, une séance
          de 20 minutes sous 72 h ouvrées — pendant douze mois.
        </p>

        <div class="groupe-btn reveal" style="--delai: 260ms">
          <a href="/diagnostic" class="btn btn-principal btn-large">
            Faire le diagnostic gratuit — 7 min
            <Icone nom="fleche" classe="fleche" />
          </a>
          <a href="/offre" class="btn btn-secondaire btn-large">Découvrir l’accompagnement</a>
        </div>

        <ul class="heros-preuves reveal" style="--delai: 340ms">
          <li><Icone nom="horloge" /> En ligne en {prix.delai}</li>
          <li><Icone nom="bouclier" /> {prix.duree} d’accompagnement compris</li>
          <li><Icone nom="etiquette" /> Tarif affiché, sans devis</li>
        </ul>
      </div>

      <div class="heros-visuel reveal" style="--delai: 200ms">
        <Maquette />
      </div>
    </div>
  </section>

  <!-- ===== BANDEAU CHIFFRES ===== -->
  <section class="chiffres">
    <div class="rail chiffres-grille">
      <div class="chiffre reveal">
        <strong>{prix.delai}</strong>
        <span>entre notre premier échange et la mise en ligne de votre socle complet.</span>
      </div>
      <div class="chiffre reveal" style="--delai: 80ms">
        <strong>{prix.duree}</strong>
        <span>de filet : une séance de déblocage sous 72 h ouvrées, chaque fois que vous en avez besoin.</span>
      </div>
      <div class="chiffre reveal" style="--delai: 160ms">
        <strong>1 seul</strong>
        <span>interlocuteur, du premier bilan au dernier compte rendu. Moi.</span>
      </div>
    </div>
  </section>

  <!-- ===== PROBLÈME ===== -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Le constat</span>
        <h2>Un bon praticien sur des bases fragiles reste un praticien qui rame</h2>
        <p class="chapeau">
          La plupart des thérapeutes que je rencontre ne manquent ni de compétence ni de sérieux.
          Il leur manque des fondations : un positionnement net, une offre lisible, une présence
          qu’on trouve — et quelqu’un à qui parler quand une décision coince.
        </p>
      </div>

      <div class="grille grille-3 espace-haut">
        {
          problemes.map((p, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 90}ms`}>
              <span class="pastille pastille-terre">
                <Icone nom={p.icone} />
              </span>
              <h3>{p.titre}</h3>
              <p>{p.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== LE SOCLE ===== -->
  <section class="section section-teintee">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Premier temps — {prix.delai}</span>
        <h2>Le Socle : une présence professionnelle, claire et crédible</h2>
        <p class="chapeau">
          Pas un site posé sur du flou : on clarifie d’abord ce que vous faites et pour qui, puis
          on construit tout le reste dans le bon ordre. Résultat au jour 21 : une activité
          présentable, trouvable et prête à recevoir des rendez-vous.
        </p>
      </div>

      <div class="grille grille-3 espace-haut">
        {
          solutions.map((s, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 70}ms`}>
              <span class="pastille">
                <Icone nom={s.icone} />
              </span>
              <h3>{s.titre}</h3>
              <p>{s.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== LE FILET ===== -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Deuxième temps — {prix.duree}</span>
        <h2>Le Filet : vous n’êtes plus jamais seul face à une décision</h2>
        <p class="chapeau">
          Après la mise en ligne commence le vrai quotidien : un tarif à trancher, un canal à
          choisir, une page qui ne convertit pas. Le Filet est là pour ça — pas un programme
          hebdomadaire imposé, une aide au moment précis où vous bloquez.
        </p>
      </div>

      <div class="grille grille-2 espace-haut">
        <article class="carte carte-relief reveal">
          <span class="pastille"><Icone nom="video" /></span>
          <h3>Un entretien initial de 90 minutes</h3>
          <p>
            On pose votre plan d’action pour l’année, par écrit. C’est votre feuille de route :
            vous la gardez, on s’y réfère à chaque séance.
          </p>
        </article>

        <article class="carte carte-relief reveal" style="--delai: 80ms">
          <span class="pastille"><Icone nom="horloge" /></span>
          <h3>Des séances de déblocage de 20 minutes</h3>
          <p>
            Un rendez-vous proposé sous 72 heures ouvrées, un seul sujet par séance, une décision
            claire à la fin. Pas de tour d’horizon flou qui repart dans tous les sens.
          </p>
        </article>

        <article class="carte carte-relief reveal" style="--delai: 160ms">
          <span class="pastille"><Icone nom="document" /></span>
          <h3>Un compte rendu après chaque séance</h3>
          <p>
            Ce qui a été décidé, ce que vous faites, ce que je fais. Synthétique, écrit, daté —
            pour que les décisions tiennent au-delà de la conversation.
          </p>
        </article>

        <article class="carte carte-relief reveal" style="--delai: 240ms">
          <span class="pastille"><Icone nom="coche" /></span>
          <h3>Un bilan à 6 mois, un autre à 12</h3>
          <p>
            On regarde ce qui a avancé, ce qui freine encore, et on ajuste le plan. Même si vous
            n’avez pas eu besoin du filet entre-temps — c’est bon signe.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== MÉTHODE ===== -->
  <section class="section section-teintee">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Le déroulement</span>
        <h2>Quatre étapes, du premier échange au bilan final</h2>
      </div>

      <ol class="etapes espace-haut">
        {
          etapes.map((e, i) => (
            <li class="etape reveal" style={`--delai: ${i * 90}ms`}>
              <span class="etape-numero">{e.n}</span>
              <div class="etape-corps">
                <h3>{e.titre}</h3>
                <p>{e.texte}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="reveal centre-mobile espace-haut-petit">
        <a href="/methode" class="lien-fleche">
          Voir la méthode en détail
          <Icone nom="fleche" classe="fleche" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===== TARIF ===== -->
  <section class="section" id="tarif">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Terre Ferme — l’accompagnement</span>
        <h2>Un seul accompagnement, un seul tarif, affiché</h2>
        <p class="chapeau">
          Pas de grille à trois colonnes ni de « tarif sur demande ». Ce que vous lisez ici est ce
          que vous payez : {prix.total} comptant, ou {prix.paiement3x} sans frais.
        </p>
      </div>

      <div class="tarif espace-haut">
        <article class="tarif-carte reveal">
          <div class="tarif-entete">
            <span class="tarif-libelle">Le Socle — {prix.delai}</span>
            <p class="tarif-prix">{prix.total}</p>
            <p class="tarif-note">
              Tout compris, Filet inclus. Ou {prix.paiement3x}, sans frais.
            </p>
          </div>
          <ul class="liste-cochee">
            {socle.map((item) => <li>{item}</li>)}
          </ul>
        </article>

        <article class="tarif-carte tarif-carte-vedette reveal" style="--delai: 100ms">
          <span class="tarif-ruban">Compris pendant {prix.duree}</span>
          <div class="tarif-entete">
            <span class="tarif-libelle">Le Filet — {prix.duree}</span>
            <p class="tarif-prix">Compris</p>
            <p class="tarif-note">L’accompagnement à la demande, sans supplément ni abonnement.</p>
          </div>
          <ul class="liste-cochee">
            {filet.map((item) => <li>{item}</li>)}
          </ul>
          <a href="/rendez-vous" class="btn btn-principal btn-large tarif-btn">
            Réserver mon bilan de lancement
            <Icone nom="fleche" classe="fleche" />
          </a>
        </article>
      </div>

      <div class="carte carte-douce reveal espace-haut-petit">
        <h3>Ce que je ne promets pas</h3>
        <p class="texte-doux marge-basse">
          Autant le dire tout de suite, cela évite les malentendus au bout de trois mois.
        </p>
        <ul class="liste-cochee liste-croix grille-2-liste">
          {nonPromis.map((item) => <li>{item}</li>)}
        </ul>
        <p class="texte-doux marge-haute">
          Restent <strong>hors accompagnement</strong> : la publicité payante, une boutique en
          ligne, la gestion de vos réseaux sociaux.
          <a href="/offre" class="lien-fleche marge-gauche">Voir le détail de l’accompagnement</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ===== COMPARATIF ===== -->
  <section class="section section-teintee">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">La différence</span>
        <h2>Un site seul, un coaching seul, ou les fondations et le filet</h2>
        <p class="chapeau">
          Un site à 800 € ou un coach sont des choix légitimes — si votre positionnement est déjà
          clair, ou si vous aimez construire seul. Terre Ferme sert à autre chose : tout poser dans
          le bon ordre, puis tenir la première année.
        </p>
      </div>

      <div class="espace-haut reveal">
        <Comparatif />
      </div>

      <div class="grille grille-4 espace-haut">
        {
          engagements.map((e, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 70}ms`}>
              <span class="pastille">
                <Icone nom={e.icone} />
              </span>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section">
    <div class="rail-etroit">
      <div class="entete-section reveal">
        <span class="surtitre">Questions fréquentes</span>
        <h2>Ce que l’on me demande avant de se lancer</h2>
      </div>

      <div class="faq espace-haut">
        {
          faqs.map((f, i) => (
            <details class="reveal" style={`--delai: ${i * 45}ms`}>
              <summary>{f.q}</summary>
              <p class="reponse">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <BandeCta />
</Base>

<style>
  /* --- Héros --- */
  .heros {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(110% 70% at 78% 6%, rgba(223, 234, 226, 0.9), transparent 62%),
      radial-gradient(90% 60% at 5% 0%, rgba(248, 229, 218, 0.85), transparent 60%),
      var(--creme);
  }
  .heros-halo-1 {
    width: 24rem; height: 24rem;
    top: -8rem; right: -8rem;
    background: rgba(232, 168, 92, 0.28);
  }
  .heros-halo-2 {
    width: 20rem; height: 20rem;
    bottom: -10rem; left: -8rem;
    background: rgba(46, 90, 75, 0.16);
  }

  .heros-rail {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2rem, 6vw, 3.5rem);
    padding-block: clamp(2.5rem, 8vw, 4.5rem) clamp(3rem, 9vw, 5.5rem);
  }
  .heros-texte h1 { margin-top: 1.4rem; }
  .heros-texte .chapeau { margin-top: 1.4rem; max-width: 34rem; }
  .heros-texte .groupe-btn { margin-top: 2rem; }

  .heros-preuves {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    font-size: 0.88rem;
    color: var(--encre-2);
  }
  .heros-preuves li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .heros-preuves :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--vert); }

  @media (min-width: 1024px) {
    .heros-rail {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 3rem;
    }
  }

  /* --- Chiffres --- */
  .chiffres {
    border-block: 1px solid var(--ligne);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(246, 238, 227, 0.7));
  }
  .chiffres-grille {
    display: grid;
    gap: 1.4rem;
    padding-block: clamp(1.8rem, 5vw, 2.6rem);
  }
  .chiffre { display: grid; gap: 0.35rem; }
  .chiffre strong {
    font-family: var(--police-titre);
    font-size: clamp(1.5rem, 4vw, 1.95rem);
    font-weight: 600;
    color: var(--vert);
  }
  .chiffre span { font-size: 0.93rem; color: var(--encre-2); }
  @media (min-width: 760px) {
    .chiffres-grille { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }

  /* --- Espacements utilitaires --- */
  .espace-haut { margin-top: clamp(2rem, 5vw, 3rem); }
  .espace-haut-petit { margin-top: 1.6rem; }
  .marge-basse { margin-bottom: 1.1rem; }
  .marge-haute { margin-top: 1.4rem; font-size: 0.93rem; }
  .marge-gauche { margin-left: 0.4rem; }
  .centre-mobile { display: flex; justify-content: flex-start; }

  /* --- Étapes --- */
  .etapes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    counter-reset: etape;
  }
  .etape {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
    padding: clamp(1.2rem, 3.4vw, 1.7rem);
    background: var(--blanc);
    border: 1px solid var(--ligne);
    border-radius: var(--r-l);
    box-shadow: var(--ombre-s), var(--ombre-interne);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .etape:hover { transform: translateY(-3px); box-shadow: var(--ombre-m); }
  .etape-numero {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: var(--r-m);
    background: linear-gradient(150deg, var(--vert), #1F3E34);
    color: #FFFFFF;
    font-family: var(--police-titre);
    font-size: 0.95rem;
    font-weight: 600;
    box-shadow: 0 10px 20px -14px rgba(46, 90, 75, 0.9);
  }
  .etape-corps h3 { margin-bottom: 0.4rem; }
  .etape-corps p { color: var(--encre-2); font-size: 0.97rem; }
  @media (min-width: 900px) {
    .etapes { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.15rem; }
  }

  /* --- Tarif --- */
  .tarif { display: grid; gap: 1.15rem; }
  .tarif-carte {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.2rem);
    background: var(--blanc);
    border: 1px solid var(--ligne);
    border-radius: var(--r-xl);
    box-shadow: var(--ombre-m), var(--ombre-interne);
  }
  .tarif-carte-vedette {
    background: linear-gradient(165deg, #FFFFFF, #FBF3E9);
    border-color: rgba(184, 85, 47, 0.28);
    box-shadow: var(--ombre-l), var(--ombre-interne);
  }
  .tarif-ruban {
    position: absolute;
    top: -0.85rem;
    left: clamp(1.5rem, 4vw, 2.2rem);
    padding: 0.35rem 0.9rem;
    border-radius: var(--r-pilule);
    background: linear-gradient(150deg, var(--terre), var(--terre-2));
    color: #FFF6F1;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 10px 20px -12px rgba(156, 69, 37, 0.9);
  }
  .tarif-entete { padding-bottom: 1.3rem; margin-bottom: 1.4rem; border-bottom: 1px solid var(--ligne); }
  .tarif-libelle {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vert);
  }
  .tarif-prix {
    margin-top: 0.5rem;
    font-family: var(--police-titre);
    font-size: clamp(2.4rem, 7vw, 3.2rem);
    font-weight: 600;
    line-height: 1;
    color: var(--encre);
  }
  .tarif-note { margin-top: 0.7rem; color: var(--encre-2); font-size: 0.95rem; }
  .tarif-btn { margin-top: 1.6rem; }
  @media (min-width: 860px) {
    .tarif { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  }

  .grille-2-liste { }
  @media (min-width: 640px) {
    .grille-2-liste { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem 1.5rem; }
  }
</style>
