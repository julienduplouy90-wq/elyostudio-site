---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Maquette from '../components/Maquette.astro';
import BandeCta from '../components/BandeCta.astro';
import {
  site,
  prix,
  problemes,
  solutions,
  etapes,
  elyoDirect,
  pourQui,
  faqs,
  lienDemarrer,
} from '../data/site.js';

const titre = 'Elyo Direct : développez votre cabinet | ElyoStudio';
const description = `Elyo Direct : ${prix.duree} d’accompagnement pour thérapeutes, coachs et praticiens bien-être — positionnement, site, visibilité locale, acquisition. Tarif fondateur.`;

const resultats = [
  'Un agenda plus régulier, moins dépendant du seul bouche-à-oreille',
  'Être trouvé par les personnes qui cherchent un praticien dans votre ville',
  'Une offre et des tarifs que vous présentez sans hésiter',
  'Des décisions prises en quelques heures, pas en quelques semaines',
];

const donnees = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${site.url}/#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'Service',
      '@id': `${site.url}/#accompagnement`,
      name: 'Elyo Direct — accompagnement de développement de cabinet',
      serviceType:
        'Accompagnement de 6 mois : positionnement, site internet, visibilité locale, acquisition et accès direct',
      provider: { '@id': `${site.url}/#studio` },
      areaServed: { '@type': 'Country', name: 'France' },
      audience: {
        '@type': 'Audience',
        audienceType: 'Thérapeutes, praticiens bien-être, professeurs de yoga et coachs',
      },
      offers: {
        '@type': 'Offer',
        price: '990',
        priceCurrency: 'EUR',
        description: `${prix.total} pour ${prix.duree}, ou ${prix.paiement3x} sans frais. Tarif fondateur réservé aux ${prix.placesFondateur} premiers cabinets.`,
        url: `${site.url}/offre`,
        availability: 'https://schema.org/LimitedAvailability',
      },
    },
  ],
};
---

<Base titre={titre} description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(donnees)} />

  <!-- ===== HÉROS ===== -->
  <section class="heros">
    <span class="heros-arc" aria-hidden="true"></span>

    <div class="rail heros-rail">
      <div class="heros-texte">
        <span class="heros-surtitre reveal">
          Thérapeutes · praticiens bien-être · professeurs de yoga · coachs
        </span>

        <h1 class="reveal" style="--delai: 90ms">
          Votre cabinet mérite plus qu’un beau site.
        </h1>

        <p class="heros-chapeau reveal" style="--delai: 180ms">
          Elyo Direct, c’est {prix.duree} d’accompagnement pour construire le système qui permet à
          votre cabinet d’être trouvé, compris et choisi : positionnement, site, visibilité
          locale, acquisition — et moi à vos côtés à chaque décision.
        </p>

        <div class="groupe-btn reveal" style="--delai: 260ms">
          <a href="/offre" class="btn btn-principal btn-large">
            Découvrir Elyo Direct
            <Icone nom="fleche" classe="fleche" />
          </a>
          <a href="/methode" class="btn btn-clair btn-large">Voir comment ça fonctionne</a>
        </div>

        <ul class="heros-preuves reveal" style="--delai: 340ms">
          <li><Icone nom="horloge" /> {prix.duree} d’accompagnement</li>
          <li><Icone nom="etiquette" /> Tarif fondateur, {prix.placesFondateur} places, affiché plus bas</li>
          <li><Icone nom="cadenas" /> Tout vous appartient</li>
        </ul>
      </div>

      <div class="heros-visuel reveal" style="--delai: 200ms">
        <Maquette />
      </div>
    </div>
  </section>

  <!-- ===== BANDEAU ===== -->
  <section class="chiffres">
    <div class="rail chiffres-grille">
      <div class="chiffre reveal">
        <strong>{prix.duree}</strong>
        <span>d’accompagnement complet, du diagnostic au suivi des résultats.</span>
      </div>
      <div class="chiffre reveal" style="--delai: 80ms">
        <strong>Accès direct</strong>
        <span>une aide humaine continue, sans compteur de rendez-vous.</span>
      </div>
      <div class="chiffre reveal" style="--delai: 160ms">
        <strong>1 interlocuteur</strong>
        <span>Julien, du premier échange au dernier suivi.</span>
      </div>
    </div>
  </section>

  <!-- ===== PROBLÈME ===== -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Ce que vivent la plupart des praticiens</span>
        <h2>Bon dans votre pratique, invisible en dehors du cabinet</h2>
        <p class="chapeau">
          Les praticiens que je rencontre ne manquent ni de compétence ni de sérieux. Il leur
          manque un système : être trouvé, être compris, et transformer ça en rendez-vous —
          sans y passer leurs soirées. C’est ce que je mets en place avec vous.
        </p>
      </div>

      <div class="grille grille-3 espace-haut">
        {
          problemes.map((p, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 90}ms`}>
              <span class="pastille pastille-terre">
                <Icone nom={p.icone} />
              </span>
              <h3>{p.titre}</h3>
              <p>{p.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== RÉSULTAT RECHERCHÉ ===== -->
  <section class="section section-teintee">
    <div class="rail resultat-rail">
      <div class="entete-section reveal">
        <span class="surtitre">Ce que je construis avec vous</span>
        <h2>Un cabinet qu’on trouve, qu’on comprend, et qu’on choisit</h2>
        <p class="chapeau">
          Pas un site de plus : un système complet, que je mets en place dans le bon ordre, que
          vous gardez et que vous savez faire vivre.
        </p>
      </div>
      <ul class="liste-cochee resultat-liste reveal" style="--delai: 120ms">
        {resultats.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===== CE QUI EST MIS EN PLACE ===== -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Elyo Direct</span>
        <h2>Ce que je mets en place pendant les {prix.duree}</h2>
        <p class="chapeau">
          Du diagnostic de votre activité au suivi des résultats, chaque brique sert la suivante.
          Le site n’en est qu’une — celle qui transforme la visibilité en rendez-vous.
        </p>
      </div>

      <div class="grille grille-3 espace-haut">
        {
          solutions.map((s, i) => (
            <article class="carte carte-relief reveal" style={`--delai: ${i * 70}ms`}>
              <span class="pastille">
                <Icone nom={s.icone} />
              </span>
              <h3>{s.titre}</h3>
              <p>{s.texte}</p>
            </article>
          ))
        }
      </div>

      <div class="reveal centre-mobile espace-haut-petit">
        <a href="/offre" class="lien-fleche">
          Voir Elyo Direct en détail
          <Icone nom="fleche" classe="fleche" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===== ELYO DIRECT ===== -->
  <section class="section section-sombre" id="elyo-direct">
    <span class="halo halo-anime direct-halo"></span>
    <div class="rail direct-rail">
      <div class="direct-texte reveal">
        <span class="surtitre surtitre-clair">L’accès direct — compris pendant les {prix.duree}</span>
        <h2>{elyoDirect.accroche}</h2>
        <p class="direct-chapeau">
          Pendant les {prix.duree}, vous n’attendez pas le prochain rendez-vous pour demander de
          l’aide. Vous me sollicitez quand vous en avez besoin, je réponds de la manière la plus
          efficace selon la situation. Sans compteur.
        </p>
        <ul class="direct-situations">
          {elyoDirect.situations.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <div class="direct-canaux">
        {
          elyoDirect.canaux.map((c, i) => (
            <article class="direct-canal reveal" style={`--delai: ${i * 80}ms`}>
              <span class="direct-icone"><Icone nom={c.icone} /></span>
              <div>
                <h3>{c.titre}</h3>
                <p>{c.texte}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>  <!-- ===== DIFFÉRENCIATION ===== -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Ce qui change avec Elyo</span>
        <h2>Ni une agence classique, ni une formation, ni un consultant</h2>
        <p class="chapeau">
          Ces trois approches échouent souvent au même endroit : vous laisser seul au moment de
          faire. Elyo Direct combine les trois choses qui ne fonctionnent pas séparées — la
          stratégie, la mise en œuvre réelle et l’accompagnement dans la durée.
        </p>
      </div>
      <div class="grille grille-3 espace-haut">
        <article class="carte carte-relief reveal">
          <span class="pastille"><Icone nom="gabarit" /></span>
          <h3>Pas une agence qui livre puis disparaît</h3>
          <p>
            Le site n’est pas la fin de la mission, c’est le début. Une fois en ligne, on le fait
            travailler : visibilité, contenu, ajustements, mois après mois.
          </p>
        </article>
        <article class="carte carte-relief reveal" style="--delai: 90ms">
          <span class="pastille"><Icone nom="video" /></span>
          <h3>Pas une formation en vidéos</h3>
          <p>
            Je ne vous laisse pas apprendre un deuxième métier. On réfléchit ensemble, puis je
            construis réellement : pages, réservation, fiche Google, automatisations.
          </p>
        </article>
        <article class="carte carte-relief reveal" style="--delai: 180ms">
          <span class="pastille"><Icone nom="document" /></span>
          <h3>Pas un consultant qui recommande sans faire</h3>
          <p>
            Les recommandations sont mises en place, pour de vrai. Et pendant {prix.duree}, on
            ajuste selon ce que disent les résultats — pas selon le plan initial.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== DÉROULÉ ===== -->
  <section class="section">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Comment ça se passe</span>
        <h2>Du premier jour au sixième mois, ce que je fais avec vous</h2>
      </div>

      <ol class="etapes espace-haut">
        {
          etapes.map((e, i) => (
            <li class="etape reveal" style={`--delai: ${i * 90}ms`}>
              <span class="etape-numero">{e.n}</span>
              <div class="etape-corps">
                <h3>{e.titre}</h3>
                <p>{e.texte}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="reveal centre-mobile espace-haut-petit">
        <a href="/methode" class="lien-fleche">
          Voir la méthode en détail
          <Icone nom="fleche" classe="fleche" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===== POUR QUI ===== -->
  <section class="section section-teintee">
    <div class="rail resultat-rail">
      <div class="entete-section reveal">
        <span class="surtitre">À qui s’adresse Elyo Direct</span>
        <h2>Aux professionnels de l’accompagnement qui veulent un cabinet qui tourne</h2>
      </div>
      <ul class="liste-cochee resultat-liste reveal" style="--delai: 120ms">
        {pourQui.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===== TARIF ===== -->
  <section class="section" id="tarif">
    <div class="rail">
      <div class="entete-section reveal">
        <span class="surtitre">Tarif fondateur</span>
        <h2>{prix.total} pour {prix.duree} — réservé aux {prix.placesFondateur} premiers cabinets</h2>
        <p class="chapeau">
          Elyo Direct est en phase de lancement : je travaille avec mes premiers cabinets pour
          affiner la méthode et mesurer précisément les résultats. En contrepartie, les {prix.placesFondateur} premiers
          bénéficient de ce tarif. Il passera ensuite à {prix.tarifSuivant}. Ce n’est pas une
          promotion : c’est le prix de la phase de lancement.
        </p>
      </div>

      <div class="tarif espace-haut">
        <article class="tarif-carte tarif-carte-vedette reveal">
          <span class="tarif-ruban">Tarif fondateur — {prix.placesFondateur} places</span>
          <div class="tarif-entete">
            <span class="tarif-libelle">Elyo Direct — accompagnement complet, {prix.duree}</span>
            <p class="tarif-prix">{prix.total}</p>
            <p class="tarif-note">Comptant, ou {prix.paiement3x} sans frais. Le même montant.</p>
          </div>
          <ul class="liste-cochee">
            <li>Diagnostic, positionnement, offres et tarifs</li>
            <li>Site créé ou optimisé, prise de rendez-vous en ligne</li>
            <li>Fiche Google, référencement local, contenu</li>
            <li>Acquisition, suivi des résultats, optimisation continue</li>
            <li>Accès direct pendant toute la durée, sans compteur</li>
          </ul>
          <div class="groupe-btn tarif-actions">
            <a href={lienDemarrer} class="btn btn-principal btn-large">
              Démarrer Elyo Direct — {prix.total}
              <Icone nom="fleche" classe="fleche" />
            </a>
            <a href="/rendez-vous" class="btn btn-secondaire btn-large">J’ai besoin d’en parler d’abord</a>
          </div>
          <p class="tarif-mention">
            Les budgets publicitaires éventuels et les outils tiers restent à votre charge.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== JULIEN ===== -->
  <section class="section section-teintee">
    <div class="rail julien-rail">
      <img
        class="julien-photo reveal"
        src="/images/julien-duplouy-220.webp"
        srcset="/images/julien-duplouy-220.webp 220w, /images/julien-duplouy-440.webp 440w"
        sizes="(min-width: 900px) 180px, 40vw"
        width="220"
        height="220"
        alt="Julien Duplouy, fondateur d’ElyoStudio"
        loading="lazy"
      />
      <div class="julien-texte reveal" style="--delai: 100ms">
        <span class="surtitre">Qui vous accompagne</span>
        <h2>Julien Duplouy, fondateur d’ElyoStudio</h2>
        <p>
          Plusieurs années en communication et marketing digital, puis le même constat répété chez
          les indépendants de l’accompagnement : compétents, appréciés, invisibles. J’ai créé
          ElyoStudio pour leur apporter ce qui manque — un système complet, un prix affiché, et
          quelqu’un à qui parler quand une décision bloque.
        </p>
        <p>
          Je démarre cet accompagnement avec mes premiers cabinets. Je ne vous promets pas un
          agenda plein en 90 jours : je vous promets des fondations solides, un travail sérieux,
          et une présence réelle pendant {prix.duree}.
        </p>
        <a href="/a-propos" class="lien-fleche">
          En savoir plus sur ma façon de travailler
          <Icone nom="fleche" classe="fleche" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section">
    <div class="rail-etroit">
      <div class="entete-section reveal">
        <span class="surtitre">Questions fréquentes</span>
        <h2>Ce que l’on me demande avant de démarrer</h2>
      </div>

      <div class="faq espace-haut">
        {
          faqs.map((f, i) => (
            <details class="reveal" style={`--delai: ${i * 45}ms`}>
              <summary>{f.q}</summary>
              <p class="reponse">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <BandeCta />
</Base>

<style>
  /* --- Héros, bleu nuit --- */
  .heros {
    position: relative;
    overflow: hidden;
    color: #FFFFFF;
    background:
      radial-gradient(90% 70% at 100% 0%, rgba(43, 65, 120, 0.9), transparent 60%),
      linear-gradient(160deg, #0F1A33 0%, #1C2E57 62%, #22396B 100%);
  }
  .heros-arc {
    position: absolute;
    right: -12rem;
    top: -14rem;
    width: 40rem;
    height: 40rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    pointer-events: none;
  }
  .heros-rail {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2rem, 6vw, 3.5rem);
    padding-block: clamp(2.8rem, 8vw, 5rem) clamp(3rem, 9vw, 5.5rem);
  }
  .heros-surtitre {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
  .heros-texte h1 {
    margin-top: 1.2rem;
    color: #FFFFFF;
    font-size: clamp(2.2rem, 6.2vw, 3.7rem);
    line-height: 1.04;
  }
  .heros-chapeau {
    margin-top: 1.4rem;
    max-width: 34rem;
    font-size: clamp(1.02rem, 2.2vw, 1.15rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
  }
  .heros-texte .groupe-btn { margin-top: 2rem; }
  .heros-preuves {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.78);
  }
  .heros-preuves li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .heros-preuves :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--ambre); }

  @media (min-width: 1024px) {
    .heros-rail { grid-template-columns: 1.05fr 0.95fr; align-items: center; gap: 3rem; }
  }

  /* --- Bandeau --- */
  .chiffres { border-block: 1px solid var(--ligne); background: var(--blanc); }
  .chiffres-grille { display: grid; gap: 1.4rem; padding-block: clamp(1.8rem, 5vw, 2.6rem); }
  .chiffre { display: grid; gap: 0.35rem; }
  .chiffre strong {
    font-family: var(--police-titre);
    font-size: clamp(1.5rem, 4vw, 1.95rem);
    font-weight: 600;
    color: var(--vert);
  }
  .chiffre span { font-size: 0.93rem; color: var(--encre-2); }
  @media (min-width: 760px) { .chiffres-grille { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }

  /* --- Utilitaires --- */
  .espace-haut { margin-top: clamp(2rem, 5vw, 3rem); }
  .espace-haut-petit { margin-top: 1.6rem; }
  .centre-mobile { display: flex; justify-content: flex-start; }

  /* --- Résultat / pour qui --- */
  .resultat-rail { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .resultat-liste { gap: 0.9rem; font-size: 1.02rem; }
  @media (min-width: 900px) {
    .resultat-rail { grid-template-columns: 1.1fr 0.9fr; }
    .resultat-rail .entete-section { margin-bottom: 0; }
  }

  /* --- Elyo Direct --- */
  .section-sombre {
    position: relative;
    overflow: hidden;
    color: #FFFFFF;
    background: linear-gradient(150deg, #0F1A33 0%, #1C2E57 60%, #22396B 100%);
  }
  .direct-halo {
    width: 26rem; height: 26rem;
    top: -10rem; right: -8rem;
    background: rgba(217, 160, 106, 0.22);
  }
  .direct-rail { position: relative; z-index: 1; display: grid; gap: clamp(2rem, 5vw, 3.5rem); }
  .surtitre-clair { color: var(--ambre); }
  .direct-texte h2 { color: #FFFFFF; }
  .direct-chapeau {
    margin-top: 1.1rem;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.7;
  }
  .direct-situations {
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .direct-situations li {
    padding: 0.45rem 0.9rem;
    border-radius: var(--r-pilule);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.88rem;
  }
  .direct-canaux { display: grid; gap: 0.9rem; }
  .direct-canal {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.1rem 1.2rem;
    border-radius: var(--r-l);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
  }
  .direct-icone {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--r-m);
    background: rgba(217, 160, 106, 0.18);
    color: var(--ambre);
  }
  .direct-icone :global(svg) { width: 1.3rem; height: 1.3rem; }
  .direct-canal h3 { color: #FFFFFF; font-size: 1.05rem; margin-bottom: 0.3rem; }
  .direct-canal p { color: rgba(255, 255, 255, 0.76); font-size: 0.93rem; }
  @media (min-width: 960px) {
    .direct-rail { grid-template-columns: 1.1fr 0.9fr; align-items: center; }
  }

  /* --- Étapes --- */
  .etapes { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .etape {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
    padding: clamp(1.2rem, 3.4vw, 1.7rem);
    background: var(--blanc);
    border: 1px solid var(--ligne);
    border-radius: var(--r-l);
    box-shadow: var(--ombre-s);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .etape:hover { transform: translateY(-3px); box-shadow: var(--ombre-m); }
  .etape-numero {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: var(--r-m);
    background: linear-gradient(150deg, var(--vert), #0F1A33);
    color: #FFFFFF;
    font-family: var(--police-titre);
    font-size: 0.95rem;
    font-weight: 600;
  }
